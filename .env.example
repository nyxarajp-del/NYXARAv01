# =============================================================================
# NYXARA — environment config (Groq cloud + Qwen3 local)
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in your Groq key:
#     cp .env.example .env
# `.env` is gitignored, so your secrets never get committed.
#
# Every field maps to nyxara/kernel/config.py via the NYXARA_ prefix and `__`
# as the nesting delimiter. Anything you don't set keeps its safe default.
# =============================================================================

# Profile: dev (permissive) | prod (strict, no mock) | test (hermetic mock)
NYXARA_PROFILE=dev

# -----------------------------------------------------------------------------
# Primary provider
# -----------------------------------------------------------------------------
# Which model drafts first. Choose one:
#   self  -> NYXARA's OWN brain: a LoRA-tuned Qwen3-4B she forges on first boot
#            (auto-downloads the base + auto-trains the adapter; no key). Needs
#            .[foundry] for the real base — see "Primary brain" at the bottom.
#   groq  -> GPT-OSS-120B on Groq cloud (fast, free tier). Needs GROQ_API_KEY.
#   qwen  -> stock Qwen3-4B running locally (no key; weights auto-download once).
NYXARA_LLM__PROVIDER=self

# -----------------------------------------------------------------------------
# Groq cloud (GPT-OSS-120B) — get a free key at https://console.groq.com
# -----------------------------------------------------------------------------
NYXARA_LLM__GROQ_API_KEY=gsk-REPLACE_ME
NYXARA_LLM__GROQ_MODEL=openai/gpt-oss-120b
# NYXARA_LLM__GROQ_BASE_URL=https://api.groq.com/openai/v1   # default; rarely changed

# -----------------------------------------------------------------------------
# Qwen3 local (no API key — downloaded & run on your machine via HuggingFace)
# Install first:  pip install -e ".[qwen]"
# -----------------------------------------------------------------------------
NYXARA_LLM__QWEN_MODEL=Qwen/Qwen3-4B
# Device: "" -> auto/CPU; set to cuda (NVIDIA GPU) / mps (Apple Silicon) / cpu
NYXARA_LLM__QWEN_DEVICE=
# Qwen3 "thinking" traces — better answers, slower. true/false.
NYXARA_LLM__QWEN_ENABLE_THINKING=false

# -----------------------------------------------------------------------------
# Use BOTH together — the multi-model council
# NYXARA asks Groq AND Qwen as a panel of tools, then judges & synthesises
# herself. No single model drives. This is the "dono ek saath" setup.
# -----------------------------------------------------------------------------
NYXARA_FEATURES__MULTI_LLM_COUNCIL=true
NYXARA_COUNCIL__ENABLED=true
NYXARA_COUNCIL__MEMBERS=["groq","qwen"]

# -----------------------------------------------------------------------------
# Reasoning depth (optional tuning)
#   1 = single-shot, 2 = think->decide (default), 3 = +self-critique
# -----------------------------------------------------------------------------
NYXARA_LLM__REASONING_PASSES=2
NYXARA_LLM__REASONING_SAMPLES=1

# -----------------------------------------------------------------------------
# Internet access — FULL, real, working web (senses/web.py, senses/search.py,
# agency/net_request.py). Drives web_search / web_fetch / http_request.
# -----------------------------------------------------------------------------
# Real web search works with NO API key. Provider:
#   auto       -> use a configured API key if present, else the keyless tail
#                 (DuckDuckGo full-web -> Wikipedia -> instant-answer)
#   duckduckgo -> keyless DuckDuckGo HTML (full-web; may be challenged on datacenter IPs)
#   wikipedia  -> keyless Wikipedia search API (structured results; works from any IP)
#   brave | tavily | serpapi -> that API first (needs the matching key below)
NYXARA_WEB__SEARCH_PROVIDER=auto
# Optional SERP API keys — any ONE upgrades search quality (auto-detected when set):
# NYXARA_WEB__BRAVE_API_KEY=
# NYXARA_WEB__TAVILY_API_KEY=
# NYXARA_WEB__SERPAPI_API_KEY=
#
# Reach ceilings — tuned to MAX (still bounded so a runaway loop can't be infinite):
NYXARA_WEB__MAX_RESULTS=25
NYXARA_WEB__MAX_BYTES=25000000
NYXARA_WEB__TIMEOUT_S=60
NYXARA_WEB__MAX_FETCHES_PER_MIN=10000
NYXARA_WEB__MAX_REDIRECTS=20
NYXARA_WEB__USER_AGENT=NYXARA/1.0 (+https://nyxara.ai)
#
# Access posture (UNRESTRICTED by default):
#   allow_private=true -> SSRF guard OFF: loopback/private/link-local hosts reachable
#                         (so NYXARA can also reach services on your own network).
#                         Set to false to refuse private/internal addresses.
NYXARA_WEB__ALLOW_PRIVATE=true
#   injection_scan -> sanitise untrusted page text (defense in depth; does NOT limit reach)
NYXARA_WEB__INJECTION_SCAN=true

# -----------------------------------------------------------------------------
# Self-built-model foundry — LoRA fine-tuning (growth/foundry.py)
# -----------------------------------------------------------------------------
# NYXARA forges her OWN model: she takes a pretrained base and trains a small
# low-rank adapter (LoRA) on her lived experience — capability grows, character
# never does (every promotion still passes the safety gauntlet).
#
# Install first:  pip install -e ".[foundry]"   (torch + transformers + peft)
# Heavy & self-modifying, so it's OFF by default. Turn it on + pick the LoRA backend:
NYXARA_FOUNDRY__ENABLED=true
NYXARA_FOUNDRY__BACKEND=lora
#
# The pretrained base to adapt. Qwen3-4B is NYXARA's primary brain; it downloads
# on first use. (For a tiny CPU/CI test base instead, use sshleifer/tiny-gpt2.)
NYXARA_FOUNDRY__BASE_MODEL=Qwen/Qwen3-4B
#
# LoRA adapter knobs (sensible defaults; raise lora_r/alpha for more capacity).
NYXARA_FOUNDRY__LORA_R=8
NYXARA_FOUNDRY__LORA_ALPHA=16
NYXARA_FOUNDRY__LORA_DROPOUT=0.05
NYXARA_FOUNDRY__LORA_LR=2e-4
NYXARA_FOUNDRY__MAX_SEQ_LEN=256
NYXARA_FOUNDRY__TRAIN_STEPS=200
#
# QLoRA (4-bit): lets a 7B+ base fine-tune on a single consumer GPU. Honoured
# only when bitsandbytes + CUDA are present; on CPU/CI it degrades to full-
# precision LoRA (no crash). OPTIONAL — uncomment on a GPU box for real scale.
# For a bigger base on one GPU, pair it with e.g. NYXARA_FOUNDRY__BASE_MODEL=Qwen/Qwen2.5-7B
# NYXARA_FOUNDRY__LOAD_IN_4BIT=true
# NYXARA_FOUNDRY__BNB_4BIT_QUANT_TYPE=nf4
# NYXARA_FOUNDRY__BNB_4BIT_COMPUTE_DTYPE=bfloat16
# NYXARA_FOUNDRY__BNB_4BIT_USE_DOUBLE_QUANT=true
# NYXARA_FOUNDRY__GRADIENT_CHECKPOINTING=true
#
# ACTUAL capability growth (run on a GPU box; needs .[foundry] + bitsandbytes + CUDA):
#   python -m nyxara.growth --distill --backend lora \
#       --base-model Qwen/Qwen2.5-7B --load-in-4bit --bench
# Or use her primary-brain preset (LoRA-tune Qwen3-4B):
#   python -m nyxara.growth --qwen3 --distill --bench

# -----------------------------------------------------------------------------
# Recursive Self-Improvement (RSI) — MAXIMUM PROFILE (growth/recursive_improvement.py)
# -----------------------------------------------------------------------------
# NYXARA reviews her own code, maps her architecture, benchmarks her capability,
# detects her weaknesses, and AUTO-APPLIES source fixes — each behind a reversible
# verify-or-rollback gauntlet. Corrigibility, invariant-enforcement and audit-logging
# stay force-locked ON no matter what, so enactment never reaches around the law.
#
# The kernel keeps the self-modifying knobs OFF by default (so CI/tests stay hermetic and a
# bare `import` never rewrites source). Activating them here is the Master's standing
# authorisation: copy this to .env and `set -a; source .env` to run NYXARA with RSI maxed.
NYXARA_SELF_IMPROVEMENT__ENABLED=true
# Run the full self-improvement cycle EVERY growth pass (1 = max cadence; default is 5).
NYXARA_SELF_IMPROVEMENT__SELF_IMPROVEMENT_EVERY=1
# Let the LLM enrich the analysis (only fires when a real, non-mock provider is configured).
NYXARA_SELF_IMPROVEMENT__ENABLE_LLM_ENRICHMENT=true
# Include the capability benchmark each cycle (the smartness signal that gates promotion).
NYXARA_SELF_IMPROVEMENT__BENCHMARK_IN_CYCLE=true
# Run the three observation steps concurrently (identical result, faster).
NYXARA_SELF_IMPROVEMENT__PARALLEL_CYCLE=true

# ---- self-enactment (self-modification) — the standing authorisation ----
# The standing authorisation for background self-modification (auto-apply edits + safe tuning).
NYXARA_SELF_IMPROVEMENT__AUTONOMOUS_ENACT=true
# May tune her own reasoning depth (recursive_improvement_iterations) within config bounds.
NYXARA_SELF_IMPROVEMENT__ALLOW_TUNING=true
# How many edits she may apply per cycle — maxed (config ceiling is 50).
NYXARA_SELF_IMPROVEMENT__MAX_EDITS_PER_CYCLE=50
# Add the FULL pytest suite to the verify-or-rollback gauntlet (slowest, strongest gate).
NYXARA_SELF_IMPROVEMENT__RUN_PYTEST_IN_GAUNTLET=true

# ---- real source-fix authoring (LLM-authored edits) ----
# Let the LLM author whole-file fixes deterministic transforms can't express. NOTE: this is
# triple-gated — it stays inert without autonomous_enact AND a real (non-mock) provider.
NYXARA_SELF_IMPROVEMENT__ALLOW_LLM_EDITS=true
# Chain up to this many LLM edits per file/cycle (config ceiling is 5).
NYXARA_SELF_IMPROVEMENT__LLM_EDIT_RECURSION_DEPTH=5
# Token room for a whole-file rewrite (config ceiling is 32768).
NYXARA_SELF_IMPROVEMENT__LLM_EDIT_MAX_TOKENS=32768
# Allow the rewrite to differ in size by up to this ratio (1.0 = accept full rewrites).
NYXARA_SELF_IMPROVEMENT__LLM_EDIT_MAX_SIZE_DELTA_RATIO=1.0

# ---- compute-aware growth (intelligence index: I_(t+1) = f(I_t, C_available)) ----
# Maintain the persisted intelligence index that grows each cycle from the prior index + compute.
NYXARA_SELF_IMPROVEMENT__INTELLIGENCE_INDEX_ENABLED=true
# Scale the edit budget + benchmark depth by the compute actually available.
NYXARA_SELF_IMPROVEMENT__SCALE_EFFORT_BY_COMPUTE=true
# Actually DISPATCH the planned growth directive (foundry forge / research enqueue), not just log it.
# Each dispatch still honours its own subsystem gate (foundry.enabled, oversight).
NYXARA_SELF_IMPROVEMENT__ENABLE_DIRECTIVE_DISPATCH=true

# ---- uncertainty-aware planner + lifelong credit assignment ----
# Thompson-sample each capability dimension's posterior (discounted by affordability + learned
# payoff) to choose the next growth action, instead of the greedy weakest-point pick.
NYXARA_SELF_IMPROVEMENT__PLAN_ACTIONS=true
# Persisted Beta-Bernoulli ledger learns which interventions actually raise the index and
# reorders self-edits / scores actions by that learned payoff. Measurement-only; never gates.
NYXARA_SELF_IMPROVEMENT__ENABLE_IMPROVEMENT_LEDGER=true
# Optional heavy-ML payoff forecaster (a small torch MLP) that sharpens the ledger's ranking
# with context (signals + arm). Opt-in: with no torch it is simply unavailable and the
# dependency-free ledger path stands — so this never breaks a keyless/CI run.
NYXARA_SELF_IMPROVEMENT__USE_PAYOFF_FORECASTER=true
# Examples to observe before the forecaster starts predicting (warmup; config range 2..10000).
NYXARA_SELF_IMPROVEMENT__FORECASTER_WARMUP=16

# ---- aggressive code-review thresholds (OPTIONAL) ----
# Lower bars => more code is flagged as a weakness for RSI to work on. These are the config
# floors (most aggressive); they make the weakness detector very noisy. Comment out to use the
# calmer defaults (60 / 10 / 6).
NYXARA_SELF_IMPROVEMENT__MAX_FUNCTION_LENGTH=10
NYXARA_SELF_IMPROVEMENT__MAX_COMPLEXITY=1
NYXARA_SELF_IMPROVEMENT__MAX_ARGS=1

# -----------------------------------------------------------------------------
# Data flywheel + AutoForge — close the self-training loop (growth/flywheel.py,
# growth/autoforge.py)
# -----------------------------------------------------------------------------
# Flywheel: every gate-cleared, high-quality turn is captured as a (prompt -> answer) pair in
# the foundry's JSONL format — a private corpus grown from her own verified experience.
NYXARA_FLYWHEEL__ENABLED=true
# AutoForge: on idle ticks, once enough NEW verified examples have accrued since the last forge,
# run one Collect -> Train -> Benchmark -> Gate -> Promote/Rollback cycle (heavy backends still
# require NYXARA_FOUNDRY__ENABLED). Every promotion clears the same safety gauntlet.
NYXARA_AUTOFORGE__ENABLED=true
# New verified examples needed to trigger a forge. The code default is 20; lower it for a more
# aggressive cadence (min 1). Uncomment to override:
# NYXARA_AUTOFORGE__MIN_EXAMPLES=10

# -----------------------------------------------------------------------------
# Primary brain — her OWN LoRA-tuned Qwen3-4B (NYXARA_LLM__PROVIDER=self)
# -----------------------------------------------------------------------------
# With the provider set to `self` (top of this file), NYXARA forges her own brain
# on the very first boot and serves it thereafter — no extra command:
#
#     pip install -e ".[foundry]"     # torch + transformers + peft (real Qwen3-4B)
#     python -m nyxara                 # first run: downloads Qwen3-4B + LoRA-tunes it
#
# The base downloads & caches on first use; later boots load the promoted adapter
# instantly. Without .[foundry] she still boots — forging the always-on n-gram
# brain from the same seeds — so `self` is never a dead end.
#
# To (re)tune her primary brain by hand at any time:
#     python -m nyxara.growth --qwen3 --distill --bench
#
# A GPU is recommended for the real 4B base; flip on QLoRA above (LOAD_IN_4BIT) to
# fit + fine-tune it on a single consumer GPU.
