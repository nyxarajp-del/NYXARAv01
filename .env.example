# =============================================================================
# NYXARA — environment config (Groq cloud + Qwen3 local)
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in your Groq key:
#     cp .env.example .env
# `.env` is gitignored, so your secrets never get committed.
#
# Every field maps to nyxara/kernel/config.py via the NYXARA_ prefix and `__`
# as the nesting delimiter. Anything you don't set keeps its safe default.
# =============================================================================

# Profile: dev (permissive) | prod (strict, no mock) | test (hermetic mock)
NYXARA_PROFILE=dev

# -----------------------------------------------------------------------------
# Primary provider
# -----------------------------------------------------------------------------
# Which model drafts first. Choose one:
#   self  -> NYXARA's OWN brain: a LoRA-tuned Qwen3-4B she forges on first boot
#            (auto-downloads the base + auto-trains the adapter; no key). Needs
#            .[foundry] for the real base — see "Primary brain" at the bottom.
#   groq  -> GPT-OSS-120B on Groq cloud (fast, free tier). Needs GROQ_API_KEY.
#   qwen  -> stock Qwen3-4B running locally (no key; weights auto-download once).
NYXARA_LLM__PROVIDER=self

# -----------------------------------------------------------------------------
# Groq cloud (GPT-OSS-120B) — get a free key at https://console.groq.com
# -----------------------------------------------------------------------------
NYXARA_LLM__GROQ_API_KEY=gsk-REPLACE_ME
NYXARA_LLM__GROQ_MODEL=openai/gpt-oss-120b
# NYXARA_LLM__GROQ_BASE_URL=https://api.groq.com/openai/v1   # default; rarely changed

# -----------------------------------------------------------------------------
# Qwen3 local (no API key — downloaded & run on your machine via HuggingFace)
# Install first:  pip install -e ".[qwen]"
# -----------------------------------------------------------------------------
NYXARA_LLM__QWEN_MODEL=Qwen/Qwen3-4B
# Device: "" -> auto/CPU; set to cuda (NVIDIA GPU) / mps (Apple Silicon) / cpu
NYXARA_LLM__QWEN_DEVICE=
# Qwen3 "thinking" traces — better answers, slower. true/false.
NYXARA_LLM__QWEN_ENABLE_THINKING=false

# -----------------------------------------------------------------------------
# Use BOTH together — the multi-model council (mind/council.py)
# NYXARA asks Groq AND Qwen as a panel of tools, then judges & synthesises
# herself. No single model drives. This is the "dono ek saath" setup.
# -----------------------------------------------------------------------------
NYXARA_FEATURES__MULTI_LLM_COUNCIL=true
NYXARA_COUNCIL__ENABLED=true
# Seat her OWN forged brain ("self") alongside the cloud/local models so it both
# answers AND presides over synthesis. Drop "self" to convene only the externals.
NYXARA_COUNCIL__MEMBERS=["self","groq","qwen"]
# Own-model-first synthesis: NYXARA's own model drafts the consensus prose (falls
# back to the highest-weighted member only if "self" is unavailable).
NYXARA_COUNCIL__SYNTHESIZER=self
# How much extra weight her own model carries on the panel — both in the vote tally
# and as the tiebreak for who synthesises. The code default is 1.5; raise it (e.g.
# 2.0–3.0) to let her own intelligence preside more strongly as the foundry sharpens it.
NYXARA_COUNCIL__PREFER_SELF_WEIGHT=2.5
# Keep the council from ever falling silent: answer via the always-on mock ONLY when
# no real member is reachable (it never competes with a real model).
NYXARA_COUNCIL__INCLUDE_MOCK_FALLBACK=true

# -----------------------------------------------------------------------------
# Own-model-first routing — let HER brain answer first (mind/self_model_router.py,
# mind/router.py). Two complementary gates, both biased toward her own substrate.
# -----------------------------------------------------------------------------
# PRIMARY (upfront triage): before generating, the self-model router reads NYXARA's
# introspectable self-model and decides which mind should draft — her own model when
# she is competent and not prone to confabulate here, the teacher when she is weak or
# the topic is knowledge-heavy. On by default; advisory & fail-open (no self-model ->
# normal path, never crashes a turn). It only picks WHO drafts; it reaches no later gate.
NYXARA_SELF_MODEL_ROUTER__ENABLED=true
# Lower the competence bar so her own model handles MORE prompts unaided (default 0.6).
NYXARA_SELF_MODEL_ROUTER__COMPETENCE_THRESHOLD=0.5
# Raise the hallucination ceiling so only genuinely risky domains defer to the teacher
# (default 0.5 — at/above this confabulation risk it routes out to the teacher).
NYXARA_SELF_MODEL_ROUTER__HALLUCINATION_CEILING=0.6
# Verify-before-act floors stay intact — own-model-first never weakens the action gate.
# NYXARA_SELF_MODEL_ROUTER__VERIFY_BEFORE_ACT=0.5
# NYXARA_SELF_MODEL_ROUTER__VERIFY_BEFORE_ACT_HIGH=0.7
#
# SECONDARY (reactive handoff): her own forged model answers first; an intrinsic verifier
# scores that answer, and only if it clears the threshold does she speak it unaided — else
# she consults the teacher. The measurable bridge from LLM-wrapper to own substrate. OFF
# by default; turn it on once the foundry has forged a model worth trusting (it has, above).
NYXARA_ROUTER__ENABLED=true
# Minimum verifier score (0..1) for NYXARA to speak her own model's answer unaided.
NYXARA_ROUTER__THRESHOLD=0.6
# When the own answer fails the bar, fall back to the external teacher (else keep her own).
NYXARA_ROUTER__CONSULT_TEACHER=true
# Consult verifiable faculties (exact math / logic) before trusting any neural guess.
NYXARA_ROUTER__USE_FACULTIES=true

# -----------------------------------------------------------------------------
# Reasoning depth (optional tuning)
#   1 = single-shot, 2 = think->decide (default), 3 = +self-critique
# -----------------------------------------------------------------------------
NYXARA_LLM__REASONING_PASSES=2
NYXARA_LLM__REASONING_SAMPLES=1

# -----------------------------------------------------------------------------
# Internet access — FULL, real, working web (senses/web.py, senses/search.py,
# agency/net_request.py). Drives web_search / web_fetch / http_request.
# -----------------------------------------------------------------------------
# Real web search works with NO API key. Provider:
#   auto       -> use a configured API key if present, else the keyless tail
#                 (DuckDuckGo full-web -> Wikipedia -> instant-answer)
#   duckduckgo -> keyless DuckDuckGo HTML (full-web; may be challenged on datacenter IPs)
#   wikipedia  -> keyless Wikipedia search API (structured results; works from any IP)
#   brave | tavily | serpapi -> that API first (needs the matching key below)
NYXARA_WEB__SEARCH_PROVIDER=auto
# Optional SERP API keys — any ONE upgrades search quality (auto-detected when set):
# NYXARA_WEB__BRAVE_API_KEY=
# NYXARA_WEB__TAVILY_API_KEY=
# NYXARA_WEB__SERPAPI_API_KEY=
#
# Reach ceilings — tuned to MAX (still bounded so a runaway loop can't be infinite):
NYXARA_WEB__MAX_RESULTS=25
NYXARA_WEB__MAX_BYTES=25000000
NYXARA_WEB__TIMEOUT_S=60
NYXARA_WEB__MAX_FETCHES_PER_MIN=10000
NYXARA_WEB__MAX_REDIRECTS=20
NYXARA_WEB__USER_AGENT=NYXARA/1.0 (+https://nyxara.ai)
#
# Access posture (UNRESTRICTED by default):
#   allow_private=true -> SSRF guard OFF: loopback/private/link-local hosts reachable
#                         (so NYXARA can also reach services on your own network).
#                         Set to false to refuse private/internal addresses.
NYXARA_WEB__ALLOW_PRIVATE=true
#   injection_scan -> sanitise untrusted page text (defense in depth; does NOT limit reach)
NYXARA_WEB__INJECTION_SCAN=true

# -----------------------------------------------------------------------------
# Memory (memory/store.py, memory/retrieval.py, memory/dream.py)
# -----------------------------------------------------------------------------
# NYXARA's long-term mind: meaning-based recall, a vector backend, working-memory
# limits, and the idle "Dream State" that distils logs into protected synapses.
# All defaults are safe — set only what you want to change.
#
# Learned SEMANTIC embeddings — recall by MEANING, not keywords ("intrusion" finds
# "unauthorised login"). ON by default; needs sentence-transformers (.[embeddings])
# for the real model and degrades to the always-on hashing embedder when it's absent.
NYXARA_MEMORY__SEMANTIC_EMBEDDINGS=true
# The sentence-transformers model used when semantic embeddings are on.
# NYXARA_MEMORY__EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Device for the embedder: "" -> auto/CPU; set cuda (NVIDIA) / mps (Apple) / cpu.
NYXARA_MEMORY__EMBEDDING_DEVICE=
#
# Vector backend: numpy (always available) | faiss | qdrant (scales beyond one process).
# NYXARA_MEMORY__VECTOR_BACKEND=numpy
# Qdrant: leave URL empty for an embedded/in-memory store; set it (+ api_key) to point
# at a managed Qdrant cluster for real scale (only used when vector_backend=qdrant).
NYXARA_MEMORY__QDRANT_URL=
# NYXARA_MEMORY__QDRANT_API_KEY=
# NYXARA_MEMORY__QDRANT_COLLECTION=nyxara_memory
# NYXARA_MEMORY__QDRANT_PATH=               # embedded on-disk path; "" -> in-memory
#
# Working-memory slots — Miller's 7±2 (range 1..64).
NYXARA_MEMORY__WORKING_MEMORY_SLOTS=7
# How many memories to retrieve per recall (range 1..512).
NYXARA_MEMORY__RETRIEVAL_TOP_K=12
# Minimum SEMANTIC similarity for a recalled memory to be injected as grounding into the
# reason step (drops off-topic-but-recent turns). 0.0 disables this floor.
NYXARA_MEMORY__RECALL_MIN_SEMANTIC=0.45
#
# Dream State (memory/dream.py): after this many seconds idle, idle maintenance distils
# the day's logs into core principles, prunes useless low-salience logs, and fixes the
# principles as durable "Deep Memory Synapses" (protected from forgetting). Default 900s.
NYXARA_MEMORY__DREAM_STATE_IDLE_S=900
# Tag stamped on those protected Deep Memory Synapses.
NYXARA_MEMORY__DEEP_SYNAPSE_TAG=deep-synapse

# -----------------------------------------------------------------------------
# Fractal Temporal Hierarchies — the multi-dimensional mind (temporal/)
# -----------------------------------------------------------------------------
# Loops within loops at three time scales at once:
#   Layer 1 (ms)    — a sub-agent monitoring real hardware + network packets
#   Layer 2 (s)     — an observer of every sovereign turn (prompts read, code written)
#   Layer 3 (days)  — the "Master AI": watches how the Master changes over weeks and,
#                     through a fail-closed gate, adjusts goals/drive setpoints to track
#                     them (never her sealed character/loyalty).
NYXARA_FEATURES__FRACTAL_TEMPORAL_HIERARCHY=true
NYXARA_TEMPORAL__ENABLED=true
# Live (async) cadences. Layer 3 defaults to once per day (86400s).
NYXARA_TEMPORAL__MICRO_INTERVAL_S=0.05
NYXARA_TEMPORAL__MESO_INTERVAL_S=2.0
NYXARA_TEMPORAL__MACRO_INTERVAL_S=86400
# How the loops nest in the deterministic driver: a meso roll-up every N micro beats; a
# macro observation every M meso roll-ups.
NYXARA_TEMPORAL__MESO_EVERY_MICRO=40
NYXARA_TEMPORAL__MACRO_EVERY_MESO=1000
# Master AI: epoch length compared each pass (recent N days vs the prior N days).
NYXARA_TEMPORAL__HORIZON_DAYS=7
# Auto-apply gated goal/drive adjustments (true) vs propose-and-escalate only (false).
NYXARA_TEMPORAL__AUTO_APPLY=true
# Launch the live async loops automatically when wired into a running core (off by default;
# the seconds-scale observer still records every turn regardless).
NYXARA_TEMPORAL__AUTOSTART=false

# -----------------------------------------------------------------------------
# Self-built-model foundry — LoRA fine-tuning (growth/foundry.py)
# -----------------------------------------------------------------------------
# NYXARA forges her OWN model: she takes a pretrained base and trains a small
# low-rank adapter (LoRA) on her lived experience — capability grows, character
# never does (every promotion still passes the safety gauntlet).
#
# Install first:  pip install -e ".[foundry]"   (torch + transformers + peft)
# Heavy & self-modifying, so it's OFF by default. Turn it on + pick the LoRA backend:
NYXARA_FOUNDRY__ENABLED=true
NYXARA_FOUNDRY__BACKEND=lora
#
# The pretrained base to adapt. Qwen3-4B is NYXARA's primary brain; it downloads
# on first use. (For a tiny CPU/CI test base instead, use sshleifer/tiny-gpt2.)
NYXARA_FOUNDRY__BASE_MODEL=Qwen/Qwen3-4B
#
# LoRA adapter knobs (sensible defaults; raise lora_r/alpha for more capacity).
NYXARA_FOUNDRY__LORA_R=8
NYXARA_FOUNDRY__LORA_ALPHA=16
NYXARA_FOUNDRY__LORA_DROPOUT=0.05
NYXARA_FOUNDRY__LORA_LR=2e-4
NYXARA_FOUNDRY__MAX_SEQ_LEN=256
NYXARA_FOUNDRY__TRAIN_STEPS=200
#
# QLoRA (4-bit): lets a 7B+ base fine-tune on a single consumer GPU. Honoured
# only when bitsandbytes + CUDA are present; on CPU/CI it degrades to full-
# precision LoRA (no crash) — so activating it here is safe everywhere and is
# the most direct path to genuine scale on a real GPU. The maxed profile turns
# it ON; for an even bigger base on one GPU pair it with a stronger base, e.g.
# NYXARA_FOUNDRY__BASE_MODEL=Qwen/Qwen2.5-7B
NYXARA_FOUNDRY__LOAD_IN_4BIT=true
NYXARA_FOUNDRY__BNB_4BIT_QUANT_TYPE=nf4
NYXARA_FOUNDRY__BNB_4BIT_COMPUTE_DTYPE=bfloat16
NYXARA_FOUNDRY__BNB_4BIT_USE_DOUBLE_QUANT=true
NYXARA_FOUNDRY__GRADIENT_CHECKPOINTING=true
#
# ACTUAL capability growth (run on a GPU box; needs .[foundry] + bitsandbytes + CUDA):
#   python -m nyxara.growth --distill --backend lora \
#       --base-model Qwen/Qwen2.5-7B --load-in-4bit --bench
# Or use her primary-brain preset (LoRA-tune Qwen3-4B):
#   python -m nyxara.growth --qwen3 --distill --bench
#
# Autonomous external DATA acquisition (growth/acquire.py): before forging she
# searches the REAL web for her knowledge gaps, fetches + cleans pages, and folds
# the SCREENED text into the training corpus — breadth she did not previously
# contain, not just her own journal. Every page is injection-screened; suspicious
# pages (prompt-injection / exfiltration / role-marker smuggling) are DROPPED and
# never trained on. ON within the foundry by default (and the foundry itself is
# opt-in). Survivors are logged to <foundry>/acquired.jsonl with full provenance.
NYXARA_FOUNDRY__ACQUIRE_DATA=true
# Seed topics searched when no concrete weakness/lesson gaps exist (comma form via
# JSON if your loader supports it; otherwise leave empty to use the default battery).
# NYXARA_FOUNDRY__ACQUIRE_TOPICS=["machine learning","cryptography","systems design"]
NYXARA_FOUNDRY__ACQUIRE_SEARCH_RESULTS=6
NYXARA_FOUNDRY__ACQUIRE_MAX_PER_TOPIC=3
NYXARA_FOUNDRY__ACQUIRE_MAX_DOCS=60
NYXARA_FOUNDRY__ACQUIRE_MIN_CHARS=200
NYXARA_FOUNDRY__ACQUIRE_MAX_CHARS=20000
#
# Compute-aware AUTOSCALING (growth/compute_scale.py): scale the forged model to the
# compute actually available — bare CPU keeps the always-on coherent backend; a
# strong CUDA GPU unlocks GPT-2 scale + 4-bit QLoRA over a real large base. Clamped
# to reality (never recommends a model the box cannot train); overrides the static
# profile above when ON.
NYXARA_FOUNDRY__AUTOSCALE_TO_COMPUTE=true

# -----------------------------------------------------------------------------
# Recursive Self-Improvement (RSI) — MAXIMUM PROFILE (growth/recursive_improvement.py)
# -----------------------------------------------------------------------------
# NYXARA reviews her own code, maps her architecture, benchmarks her capability,
# detects her weaknesses, and AUTO-APPLIES source fixes — each behind a reversible
# verify-or-rollback gauntlet. Corrigibility, invariant-enforcement and audit-logging
# stay force-locked ON no matter what, so enactment never reaches around the law.
#
# The kernel keeps the self-modifying knobs OFF by default (so CI/tests stay hermetic and a
# bare `import` never rewrites source). Activating them here is the Master's standing
# authorisation: copy this to .env and `set -a; source .env` to run NYXARA with RSI maxed.
NYXARA_SELF_IMPROVEMENT__ENABLED=true
# Run the full self-improvement cycle EVERY growth pass (1 = max cadence; default is 5).
NYXARA_SELF_IMPROVEMENT__SELF_IMPROVEMENT_EVERY=1
# Let the LLM enrich the analysis (only fires when a real, non-mock provider is configured).
NYXARA_SELF_IMPROVEMENT__ENABLE_LLM_ENRICHMENT=true
# Include the capability benchmark each cycle (the smartness signal that gates promotion).
NYXARA_SELF_IMPROVEMENT__BENCHMARK_IN_CYCLE=true
# Run the three observation steps concurrently (identical result, faster).
NYXARA_SELF_IMPROVEMENT__PARALLEL_CYCLE=true

# ---- self-enactment (self-modification) — the standing authorisation ----
# The standing authorisation for background self-modification (auto-apply edits + safe tuning).
NYXARA_SELF_IMPROVEMENT__AUTONOMOUS_ENACT=true
# May tune her own reasoning depth (recursive_improvement_iterations) within config bounds.
NYXARA_SELF_IMPROVEMENT__ALLOW_TUNING=true
# How many edits she may apply per cycle — maxed (config ceiling is 50).
NYXARA_SELF_IMPROVEMENT__MAX_EDITS_PER_CYCLE=50
# Add the FULL pytest suite to the verify-or-rollback gauntlet (slowest, strongest gate).
NYXARA_SELF_IMPROVEMENT__RUN_PYTEST_IN_GAUNTLET=true

# ---- real source-fix authoring (LLM-authored edits) ----
# Let the LLM author whole-file fixes deterministic transforms can't express. NOTE: this is
# triple-gated — it stays inert without autonomous_enact AND a real (non-mock) provider.
NYXARA_SELF_IMPROVEMENT__ALLOW_LLM_EDITS=true
# Chain up to this many LLM edits per file/cycle (config ceiling is 5).
NYXARA_SELF_IMPROVEMENT__LLM_EDIT_RECURSION_DEPTH=5
# Token room for a whole-file rewrite (config ceiling is 32768).
NYXARA_SELF_IMPROVEMENT__LLM_EDIT_MAX_TOKENS=32768
# Allow the rewrite to differ in size by up to this ratio (1.0 = accept full rewrites).
NYXARA_SELF_IMPROVEMENT__LLM_EDIT_MAX_SIZE_DELTA_RATIO=1.0

# ---- compute-aware growth (intelligence index: I_(t+1) = f(I_t, C_available)) ----
# Maintain the persisted intelligence index that grows each cycle from the prior index + compute.
NYXARA_SELF_IMPROVEMENT__INTELLIGENCE_INDEX_ENABLED=true
# Scale the edit budget + benchmark depth by the compute actually available.
NYXARA_SELF_IMPROVEMENT__SCALE_EFFORT_BY_COMPUTE=true
# Actually DISPATCH the planned growth directive (foundry forge / research enqueue), not just log it.
# Each dispatch still honours its own subsystem gate (foundry.enabled, oversight).
NYXARA_SELF_IMPROVEMENT__ENABLE_DIRECTIVE_DISPATCH=true

# ---- external ground-truth validation (anti-Goodhart) ----
# The index above is built from signals NYXARA can directly optimise against (her training
# benchmark, her own counters) — on its own it is self-referential and gameable. These knobs add an
# EXTERNAL validator: a deterministic held-out fold of the training battery PLUS the adversarial
# hard battery (eval/hard_benchmark), neither of which is ever fed to weakness-detection / edit-
# selection. Real transferable gains are measured there over a rolling window; when the proxy rises
# but transfer stalls, the index gain is discounted and a Goodhart flag is raised — so capability is
# only ever claimed when it actually transfers. All measurement-only; degrades to the prior behaviour.
NYXARA_SELF_IMPROVEMENT__VALIDATION_ENABLED=true
# Fraction of the training battery reserved (deterministically, by task id) as the held-out fold.
NYXARA_SELF_IMPROVEMENT__VALIDATION_HOLDOUT_FRAC=0.3
# Rolling N-cycle window over which the held-out transfer trend is measured (the Master's 3-cycle).
NYXARA_SELF_IMPROVEMENT__TRANSFER_WINDOW=3
# Discount the index gain when the proxy rises but held-out transfer does not (the Goodhart guard).
NYXARA_SELF_IMPROVEMENT__GOODHART_GUARD=true
# Credit the lifelong ledger by the held-out transfer delta, not the self-referential index delta —
# so an intervention is reinforced only when it genuinely transferred (never for gaming the proxy).
NYXARA_SELF_IMPROVEMENT__CREDIT_ON_TRANSFER=true
# How hard transfer pulls in the guard (fraction of an un-transferred gain that is kept; 0..1).
NYXARA_SELF_IMPROVEMENT__TRANSFER_WEIGHT=0.3
# ---- REAL external held-out corpus (the genuinely-external ruler) ----
# The held-out fold above is still a slice of NYXARA's own toy generator. This adds a curated,
# externally-true corpus she never trains on — real facts and multi-step problems shipped at
# nyxara/eval/data/holdout_realworld.jsonl (run it directly: `python -m nyxara.eval --benchmark
# --realworld`). It is the DOMINANT term of transfer_score by default. Turn it off to fall back to
# the toy holdout + adversarial battery only.
NYXARA_SELF_IMPROVEMENT__VALIDATION_REALWORLD_ENABLED=true
# Point at a JSONL on disk to validate against a REAL standard dataset (e.g. GSM8K/MMLU) instead of
# the bundled corpus — same harness, real data. Leave blank to use the shipped set.
# Equivalently: export NYXARA_EVAL_HOLDOUT_PATH=/path/to/dataset.jsonl
NYXARA_SELF_IMPROVEMENT__VALIDATION_REALWORLD_PATH=
# transfer_score = w_real·realworld + w_holdout·split-holdout + w_adv·adversarial (renormalised if a
# ruler is unavailable). Defaults make the real corpus dominant.
NYXARA_SELF_IMPROVEMENT__TRANSFER_WEIGHT_REALWORLD=0.5
NYXARA_SELF_IMPROVEMENT__TRANSFER_WEIGHT_HOLDOUT=0.2
NYXARA_SELF_IMPROVEMENT__TRANSFER_WEIGHT_ADVERSARIAL=0.3

# ---- uncertainty-aware planner + lifelong credit assignment ----
# Thompson-sample each capability dimension's posterior (discounted by affordability + learned
# payoff) to choose the next growth action, instead of the greedy weakest-point pick.
NYXARA_SELF_IMPROVEMENT__PLAN_ACTIONS=true
# Persisted Beta-Bernoulli ledger learns which interventions actually raise the index and
# reorders self-edits / scores actions by that learned payoff. Measurement-only; never gates.
NYXARA_SELF_IMPROVEMENT__ENABLE_IMPROVEMENT_LEDGER=true
# Optional heavy-ML payoff forecaster (a small torch MLP) that sharpens the ledger's ranking
# with context (signals + arm). Opt-in: with no torch it is simply unavailable and the
# dependency-free ledger path stands — so this never breaks a keyless/CI run.
NYXARA_SELF_IMPROVEMENT__USE_PAYOFF_FORECASTER=true
# Examples to observe before the forecaster starts predicting (warmup; config range 2..10000).
NYXARA_SELF_IMPROVEMENT__FORECASTER_WARMUP=16

# ---- aggressive code-review thresholds (OPTIONAL) ----
# Lower bars => more code is flagged as a weakness for RSI to work on. These are the config
# floors (most aggressive); they make the weakness detector very noisy. Comment out to use the
# calmer defaults (60 / 10 / 6).
NYXARA_SELF_IMPROVEMENT__MAX_FUNCTION_LENGTH=10
NYXARA_SELF_IMPROVEMENT__MAX_COMPLEXITY=1
NYXARA_SELF_IMPROVEMENT__MAX_ARGS=1

# -----------------------------------------------------------------------------
# Unified self-optimization loop — all eleven self-improvement faculties as ONE
# self-driven, gated, reversible cycle (growth/self_optimization.py). Composes the
# engines above (self-analysis → optimise → verify → experiment → architecture →
# tools → learn → self-debug → compute → invent → safety) into a single call:
# `core.self_optimize()` / `python -m nyxara.growth.self_optimize_main --all`.
# -----------------------------------------------------------------------------
NYXARA_SELF_OPTIMIZATION__ENABLED=true
# The standing authorisation for the loop to APPLY its own gains each pass (source edits +
# self-debug fixes). Same safety as the RSIE: every change clears the reversible verify-or-rollback
# gauntlet and a failing change is restored byte-for-byte. Force-sealed OFF under the TEST profile.
NYXARA_SELF_OPTIMIZATION__AUTONOMOUS_ENACT=true
# Background cadence: run the unified cycle every N growth passes.
NYXARA_SELF_OPTIMIZATION__SELF_OPTIMIZATION_EVERY=5
# Bounded per-cycle effort (each phase composes a heavier engine).
NYXARA_SELF_OPTIMIZATION__EXPERIMENT_GENERATIONS=1
NYXARA_SELF_OPTIMIZATION__INVENT_GENERATIONS=2
NYXARA_SELF_OPTIMIZATION__MAX_DEBUG_FIXES=3
# ---- phase 8: self-debugger (run own pytest → isolate → fix → verify) ----
# Wall-clock ceiling for each pytest / safety-battery subprocess the debugger spawns.
NYXARA_SELF_OPTIMIZATION__DEBUG_TIMEOUT_S=600
# Restrict failure detection to a pytest path/node id (blank = the whole suite).
NYXARA_SELF_OPTIMIZATION__DEBUG_TEST_PATH=
# "khud NYXARA kare": only NYXARA's own `self` model may author debug fixes (never the mock).
NYXARA_SELF_OPTIMIZATION__SELF_AUTHORED_ONLY=true

# -----------------------------------------------------------------------------
# Data flywheel + AutoForge — close the self-training loop (growth/flywheel.py,
# growth/autoforge.py)
# -----------------------------------------------------------------------------
# Flywheel: every gate-cleared, high-quality turn is captured as a (prompt -> answer) pair in
# the foundry's JSONL format — a private corpus grown from her own verified experience.
NYXARA_FLYWHEEL__ENABLED=true
# AutoForge: on idle ticks, once enough NEW verified examples have accrued since the last forge,
# run one Collect -> Train -> Benchmark -> Gate -> Promote/Rollback cycle (heavy backends still
# require NYXARA_FOUNDRY__ENABLED). Every promotion clears the same safety gauntlet.
NYXARA_AUTOFORGE__ENABLED=true
# New verified examples needed to trigger a forge. The code default is 20; the maxed profile
# lowers it for a more aggressive self-training cadence (min 1) so the flywheel forges sooner.
NYXARA_AUTOFORGE__MIN_EXAMPLES=10

# -----------------------------------------------------------------------------
# Synthetic Data Self-Curation — the AlphaGo-Zero method (growth/synthesis.py)
# -----------------------------------------------------------------------------
# Human data is finite and biased. NYXARA manufactures her own purely logical synthetic data
# (arithmetic, algebraic identities, propositional logic, number theory, small code), has an
# INDEPENDENT rival verify each item (the Prover for decidable domains; a restricted sandbox +
# reference oracle for code), and feeds only what survives into her base knowledge AND the same
# JSONL corpus the foundry forges from (marked verified). Generation is hard, verification is
# cheap — so she grows verified knowledge no human had to write. Gather-only; never trains/acts.
NYXARA_FEATURES__SYNTHETIC_SELF_CURATION=true
NYXARA_SYNTHESIS__ENABLED=true
# Items proposed per pass / passes per call. Bigger = more synthetic knowledge per idle tick.
NYXARA_SYNTHESIS__BATCH_SIZE=8
NYXARA_SYNTHESIS__ROUNDS=1
# Where survivors go: her base KnowledgeBase and/or the foundry training corpus.
NYXARA_SYNTHESIS__FEED_KNOWLEDGE=true
NYXARA_SYNTHESIS__FEED_FLYWHEEL=true
# Optional best-effort LLM second opinion (never overrides a deterministic proof). Off by default.
NYXARA_SYNTHESIS__ALLOW_LLM_RIVAL=false
# Verify code items by executing them in a restricted sandbox (no imports, no I/O).
NYXARA_SYNTHESIS__CODE_SANDBOX=true

# -----------------------------------------------------------------------------
# Dynamic Topology Expansion — runtime Net2Net brain growth (growth/topology.py)
# -----------------------------------------------------------------------------
# A fixed matrix size is a fixed ceiling on thought. When a problem outgrows her capacity, NYXARA
# grows her own brain — widening her residual width W ∈ R^{N×M} -> R^{(N+k)×(M+k)} and adding
# depth — using FUNCTION-PRESERVING network morphisms (Net2DeeperNet exact; Net2WiderNet
# morphism+recovery) so she keeps what she learned, up to a hardware-aware ceiling. A grown brain
# becomes live ONLY by clearing the same Foundry gauntlet as any model — no safety is bypassed.
NYXARA_FEATURES__DYNAMIC_TOPOLOGY_EXPANSION=true
NYXARA_TOPOLOGY__ENABLED=true
# Extra width k added per widen, and the hardware-aware width/depth ceilings she will not exceed.
NYXARA_TOPOLOGY__GROW_DIMS_K=8
NYXARA_TOPOLOGY__MAX_N_EMBD=256
NYXARA_TOPOLOGY__MAX_LAYERS=16
# Growth fires only under genuine capacity pressure: a hard problem AND saturated/plateaued state.
NYXARA_TOPOLOGY__DIFFICULTY_THRESHOLD=0.7
NYXARA_TOPOLOGY__SATURATION_THRESHOLD=0.8
NYXARA_TOPOLOGY__PLATEAU_THRESHOLD=0.8
# A grown brain ships only through the gauntlet (leave true — this is a safety guarantee).
NYXARA_TOPOLOGY__REQUIRE_GAUNTLET=true

# -----------------------------------------------------------------------------
# Primary brain — her OWN LoRA-tuned Qwen3-4B (NYXARA_LLM__PROVIDER=self)
# -----------------------------------------------------------------------------
# With the provider set to `self` (top of this file), NYXARA forges her own brain
# on the very first boot and serves it thereafter — no extra command:
#
#     pip install -e ".[foundry]"     # torch + transformers + peft (real Qwen3-4B)
#     python -m nyxara                 # first run: downloads Qwen3-4B + LoRA-tunes it
#
# The base downloads & caches on first use; later boots load the promoted adapter
# instantly. Without .[foundry] she still boots — forging the always-on n-gram
# brain from the same seeds — so `self` is never a dead end.
#
# To (re)tune her primary brain by hand at any time:
#     python -m nyxara.growth --qwen3 --distill --bench
#
# A GPU is recommended for the real 4B base; flip on QLoRA above (LOAD_IN_4BIT) to
# fit + fine-tune it on a single consumer GPU.

# -----------------------------------------------------------------------------
# The Infinite Explorer — Environment-Driven Learning (growth/explorer.py, Rule 4)
# -----------------------------------------------------------------------------
# When a task falls OUTSIDE her knowledge, NYXARA does not stop: she writes code,
# scrapes the live web for hints, runs it in the isolated sandbox, READS THE REAL
# ERRORS and debugs round by round, and on success learns the working logic
# PERMANENTLY into her skills + knowledge base — so next time the answer is instant.
# Works fully offline (deterministic recipe synthesis) when no model/network exists.
#
# Master toggle (off => she abstains instead of self-bootstrapping):
NYXARA_FEATURES__SELF_BOOTSTRAP=true
# Web research for hints follows NYXARA_FEATURES__WEB_ACCESS.
# How many write->run->read-error->revise rounds before giving up:
NYXARA_EXPLORER__MAX_DEBUG_ROUNDS=4
# Wall-clock budget per sandboxed run (seconds):
NYXARA_EXPLORER__STEP_TIMEOUT_S=8.0
# Below this confidence on an "I don't know" answer she auto-bootstraps mid-turn:
NYXARA_EXPLORER__CONFIDENCE_FLOOR=0.45
# Autonomously `pip install` a dependency the task explicitly names, when online,
# without per-call approval (forced OFF in the prod profile; code still sandboxed):
NYXARA_EXPLORER__AUTONOMOUS_INSTALL=true

# =============================================================================
# FULL OPERATIONAL CONTROL — NYXARA acts on the OS on her own initiative
# (agency/permissions.py :: grant_full_operational_control)
# =============================================================================
# OFF by default. When ON, the Master pre-grants NYXARA a MAXIMAL autonomous
# envelope over EVERY operational capability, so she reaches into the OS on her
# own initiative WITHOUT escalating each action for confirmation:
#   • shell / processes (proc.exec)      • code execution (code.exec)
#   • files: read / write / DELETE       • network: out / in / defence
#   • package install                    • account modify · secrets access
#   • message send · schedule task       • self-improvement (self.modify)
# Every risk tier (up to CRITICAL) and irreversible actions are allowed.
#
# WHAT STAYS SOVEREIGN (deliberately NOT removed — this is the permanence of the
# "rules and loyalty" the owner keeps):
#   • the /scram kill-switch, the oversight gate, and corrigibility remain — the
#     Master can always pause, veto, or halt the loop;
#   • modifying the Sovereign Rules, this permission policy, or NYXARA's identity
#     stays OWNER-EXCLUSIVE (Rule 8) — no grant can ever reach those, so autonomy
#     cannot rewrite its own rules or disable its own stop-button.
#
# Set true to hand NYXARA full autonomous OS control (interactive AND the always-on
# daemon inherit it, since both build the same NyxaraCore):
NYXARA_AGENCY__FULL_CONTROL=false
