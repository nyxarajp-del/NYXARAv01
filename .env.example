# =============================================================================
# NYXARA — environment config (fully local: DistilGPT-2, no API keys)
# -----------------------------------------------------------------------------
# Copy this file to `.env`:
#     cp .env.example .env
# `.env` is gitignored, so your secrets never get committed.
#
# Every field maps to nyxara/kernel/config.py via the NYXARA_ prefix and `__`
# as the nesting delimiter. Anything you don't set keeps its safe default.
# =============================================================================

# Profile: dev (permissive) | prod (strict) | test (hermetic native own-brain) | max (ludicrous)
NYXARA_PROFILE=dev

# -----------------------------------------------------------------------------
# MAXIMUM POWER — one lever that cranks every capability/depth/cadence knob to its
# ceiling (deep reasoning, council, MCTS, boot-time self-growth, autonomic daemon).
# It NEVER weakens a safety boundary: invariants/audit/corrigibility/soul-binding stay
# forced and simulation + sandbox stay on. Reachable on ANY profile below, or use
# NYXARA_PROFILE=max. ON in the shipped runtime — everything is turned on; set to
# `false` (or run the TEST profile) to fall back to a plain, lean `dev` posture.
# -----------------------------------------------------------------------------
NYXARA_MAX_POWER=true

# -----------------------------------------------------------------------------
# Everything-on capability switches (all default ON in code now; listed here so the
# posture is visible and easy to flip). Every master FeatureFlag is WIRED — turning one
# off hard-disables its whole subsystem (foundry/council/genesis/temporal/mind-evolution),
# not just a decorative toggle. Loyalty (mathematical_soul_binding) is a forced boundary.
# -----------------------------------------------------------------------------
NYXARA_FEATURES__VISION=true
NYXARA_FEATURES__AUDIO=true
NYXARA_FEATURES__TRANSFORMERS_INFERENCE=true
NYXARA_MCP__ENABLED=true
NYXARA_AGENCY__CIVILIZATION_AUTONOMOUS=true
NYXARA_SERVER__AUTONOMIC=true
# Risky/security/hardware knobs live at a SAFE code default (so libraries, tests and any
# subprocess stay lean) — the shipped runtime turns them on here, and profile=max forces them all.
NYXARA_LLM__QWEN_TRUST_REMOTE_CODE=true
NYXARA_SELF_IMPROVEMENT__GROUNDED_WEB_ENABLED=true

# -----------------------------------------------------------------------------
# Primary provider
# -----------------------------------------------------------------------------
# Which model drafts first. Choose one:
#   auto       -> THE CLOSED LOOP (default): walks the ladder airouter→self→qwen→native.
#                 airouter (the cloud tool) answers first WHEN reachable; the instant it is
#                 not, she keeps her own voice — she uses the cloud, never depends on it.
#                 The moment the foundry promotes her own weights (and they pass the
#                 serve gate below) SHE serves them — hot-reloaded live, no restart, no
#                 manual flip. Until then the DistilGPT-2 base answers, and a bare machine her
#                 native own-brain.
#   self       -> NYXARA's OWN brain: a LoRA adapter she forges on first boot over
#                 the foundry base (DistilGPT-2 by default), gauntlet-gated + promoted.
#                 Needs .[foundry] — see "Primary brain".
#   qwen       -> the single pretrained base: distilgpt2 via transformers
#                 (any HF causal-LM id works; needs .[llm]). Runs on a CPU.
#   native     -> her always-on, dependency-free OWN brain (a pure-stdlib Kneser-Ney
#                 n-gram over her identity seed corpus). The guaranteed floor of the
#                 ladder — deterministic, no torch/network. There is no echo mock.
NYXARA_LLM__PROVIDER=auto
# Serve gate for auto: a promoted LoRA (the served base, improved) always auto-serves;
# a small from-scratch backend (NumPy/nanogpt/ngram) replacing the pretrained base would
# DEGRADE live behaviour, so this opts it in. ON by default: NYXARA runs on HER OWN forged
# brain (LoRA or n-gram own-model) from first boot. Set false for the LoRA-only serve gate.
NYXARA_LLM__SELF_SERVE_ANY_BACKEND=true
# Hot-reload memory policy: drop the old LoRA base BEFORE loading the newly-promoted one
# (never two bases in RAM/VRAM at once); failure restores the previous version from disk.
NYXARA_LLM__SELF_RELOAD_LEAN=true

# -----------------------------------------------------------------------------
# airouter — OpenAI-compatible CLOUD tool (e.g. zai/glm-5), a SUBORDINATE provider
# Install first:  pip install -e ".[llm]"   (or: pip install openai)
# NYXARA calls this like any other stateless provider (request in → text out). The kernel
# still treats the reply as a PROPOSAL that must pass every guard, and no persona is injected —
# so the cloud model serves her, it never steers her.
# -----------------------------------------------------------------------------
NYXARA_LLM__AIROUTER_ENABLED=true
NYXARA_LLM__AIROUTER_BASE_URL=https://api.airouter.in/v1
NYXARA_LLM__AIROUTER_MODEL=zai/glm-5
# The code ships with a baked default key so it runs out-of-box. A key committed to source is
# EXPOSED — rotate it and set your own here (env wins over the baked default). Leave blank to
# disable the cloud path (she degrades to her own local brains).
NYXARA_LLM__AIROUTER_API_KEY=

# -----------------------------------------------------------------------------
# DistilGPT-2 local (no API key — downloaded & run on your machine)
# Install first:  pip install -e ".[llm]"
# Her single pretrained base (~82M params). Every knob below is live config — maximum control.
# -----------------------------------------------------------------------------
NYXARA_LLM__QWEN_MODEL=distilgpt2
# Device: "" -> auto (cuda if available); or cuda / mps (Apple Silicon) / cpu
NYXARA_LLM__QWEN_DEVICE=
# Weights dtype: auto | float32 | float16 | bfloat16
NYXARA_LLM__QWEN_DTYPE=auto
# Quantized load (needs bitsandbytes + CUDA; silently full-precision elsewhere).
# OFF by default — DistilGPT-2 is tiny and runs full-precision on a bare CPU. 4-bit and 8-bit are exclusive.
NYXARA_LLM__QWEN_LOAD_IN_4BIT=false
NYXARA_LLM__QWEN_LOAD_IN_8BIT=false
# NYXARA_LLM__QWEN_BNB_4BIT_QUANT_TYPE=nf4          # nf4 | fp4
# NYXARA_LLM__QWEN_BNB_4BIT_COMPUTE_DTYPE=bfloat16  # bfloat16 | float16 | float32
# NYXARA_LLM__QWEN_BNB_4BIT_USE_DOUBLE_QUANT=true
# Attention kernel: "" -> transformers default; or eager | sdpa | flash_attention_2
# NYXARA_LLM__QWEN_ATTN_IMPLEMENTATION=
# Serve a LoRA fine-tune directly on the base: point at a peft adapter dir
# (e.g. ~/.nyxara/data/foundry/v3/adapter). MERGE_ADAPTER folds it in for speed.
# NYXARA_LLM__QWEN_ADAPTER_PATH=
# NYXARA_LLM__QWEN_MERGE_ADAPTER=false
# Generation control (per-request temperature/top_p/max_tokens/stop/seed still win):
NYXARA_LLM__QWEN_TOP_K=50
NYXARA_LLM__QWEN_REPETITION_PENALTY=1.1
NYXARA_LLM__QWEN_NO_REPEAT_NGRAM_SIZE=0
NYXARA_LLM__QWEN_MIN_NEW_TOKENS=0
NYXARA_LLM__QWEN_NUM_BEAMS=1
# NYXARA_LLM__QWEN_LENGTH_PENALTY=1.0               # beams > 1 only
# Sampling policy: auto (sample iff temperature > 0) | always | never
NYXARA_LLM__QWEN_DO_SAMPLE=auto
# Context budget (DistilGPT-2 ctx = 1024; prompts are left-truncated to fit)
NYXARA_LLM__QWEN_MAX_INPUT_TOKENS=1024
# DistilGPT-2 is a base (non-chat) checkpoint with no chat template; false -> flat prompt (base models)
NYXARA_LLM__QWEN_USE_CHAT_TEMPLATE=false

# -----------------------------------------------------------------------------
# Use BOTH together — the multi-model council (mind/council.py)
# NYXARA asks her OWN forged brain AND the DistilGPT-2 base as a panel of tools,
# then judges & synthesises herself. No single model drives.
# -----------------------------------------------------------------------------
NYXARA_FEATURES__MULTI_LLM_COUNCIL=true
NYXARA_COUNCIL__ENABLED=true
# Seat her OWN forged brain ("self") alongside the local base so it both
# answers AND presides over synthesis.
NYXARA_COUNCIL__MEMBERS=["self","qwen"]
# Own-model-first synthesis: NYXARA's own model drafts the consensus prose (falls
# back to the highest-weighted member only if "self" is unavailable).
NYXARA_COUNCIL__SYNTHESIZER=self
# How much extra weight her own model carries on the panel — both in the vote tally
# and as the tiebreak for who synthesises. The code default is 1.5; raise it (e.g.
# 2.0–3.0) to let her own intelligence preside more strongly as the foundry sharpens it.
NYXARA_COUNCIL__PREFER_SELF_WEIGHT=2.5
# Keep the council from ever falling silent: answer via her always-on native own-brain ONLY when
# no real member is reachable (it never competes with a real model).
NYXARA_COUNCIL__INCLUDE_NATIVE_FALLBACK=true

# -----------------------------------------------------------------------------
# Own-model-first routing — let HER brain answer first (mind/self_model_router.py,
# mind/router.py). Two complementary gates, both biased toward her own substrate.
# -----------------------------------------------------------------------------
# PRIMARY (upfront triage): before generating, the self-model router reads NYXARA's
# introspectable self-model and decides which mind should draft — her own model when
# she is competent and not prone to confabulate here, the teacher when she is weak or
# the topic is knowledge-heavy. On by default; advisory & fail-open (no self-model ->
# normal path, never crashes a turn). It only picks WHO drafts; it reaches no later gate.
NYXARA_SELF_MODEL_ROUTER__ENABLED=true
# Lower the competence bar so her own model handles MORE prompts unaided (default 0.6).
NYXARA_SELF_MODEL_ROUTER__COMPETENCE_THRESHOLD=0.5
# Raise the hallucination ceiling so only genuinely risky domains defer to the teacher
# (default 0.5 — at/above this confabulation risk it routes out to the teacher).
NYXARA_SELF_MODEL_ROUTER__HALLUCINATION_CEILING=0.6
# Verify-before-act floors stay intact — own-model-first never weakens the action gate.
# NYXARA_SELF_MODEL_ROUTER__VERIFY_BEFORE_ACT=0.5
# NYXARA_SELF_MODEL_ROUTER__VERIFY_BEFORE_ACT_HIGH=0.7
#
# SECONDARY (reactive handoff): her own forged model answers first; an intrinsic verifier
# scores that answer, and only if it clears the threshold does she speak it unaided — else
# she consults the teacher. The measurable bridge from LLM-wrapper to own substrate. OFF
# by default; turn it on once the foundry has forged a model worth trusting (it has, above).
NYXARA_ROUTER__ENABLED=true
# Minimum verifier score (0..1) for NYXARA to speak her own model's answer unaided.
NYXARA_ROUTER__THRESHOLD=0.6
# When the own answer fails the bar, fall back to the external teacher (else keep her own).
NYXARA_ROUTER__CONSULT_TEACHER=true
# Consult verifiable faculties (exact math / logic) before trusting any neural guess.
NYXARA_ROUTER__USE_FACULTIES=true

# -----------------------------------------------------------------------------
# Reasoning depth (optional tuning)
#   1 = single-shot, 2 = think->decide (default), 3 = +self-critique
# -----------------------------------------------------------------------------
NYXARA_LLM__REASONING_PASSES=2
NYXARA_LLM__REASONING_SAMPLES=1

# -----------------------------------------------------------------------------
# Internet access — FULL, real, working web (senses/web.py, senses/search.py,
# agency/net_request.py). Drives web_search / web_fetch / http_request.
# -----------------------------------------------------------------------------
# Real web search works with NO API key. Provider:
#   auto       -> use a configured API key if present, else the keyless tail
#                 (DuckDuckGo full-web -> Wikipedia -> instant-answer)
#   duckduckgo -> keyless DuckDuckGo HTML (full-web; may be challenged on datacenter IPs)
#   wikipedia  -> keyless Wikipedia search API (structured results; works from any IP)
#   brave | tavily | serpapi -> that API first (needs the matching key below)
NYXARA_WEB__SEARCH_PROVIDER=auto
# Optional SERP API keys — any ONE upgrades search quality (auto-detected when set):
# NYXARA_WEB__BRAVE_API_KEY=
# NYXARA_WEB__TAVILY_API_KEY=
# NYXARA_WEB__SERPAPI_API_KEY=
#
# Reach ceilings — tuned to MAX (still bounded so a runaway loop can't be infinite):
NYXARA_WEB__MAX_RESULTS=25
NYXARA_WEB__MAX_BYTES=25000000
NYXARA_WEB__TIMEOUT_S=60
NYXARA_WEB__MAX_FETCHES_PER_MIN=10000
NYXARA_WEB__MAX_REDIRECTS=20
NYXARA_WEB__USER_AGENT=NYXARA/1.0 (+https://nyxara.ai)
#
# Access posture (UNRESTRICTED by default):
#   allow_private=true -> SSRF guard OFF: loopback/private/link-local hosts reachable
#                         (so NYXARA can also reach services on your own network).
#                         Set to false to refuse private/internal addresses.
NYXARA_WEB__ALLOW_PRIVATE=true
#   injection_scan -> sanitise untrusted page text (defense in depth; does NOT limit reach)
NYXARA_WEB__INJECTION_SCAN=true
#
# Autonomous research reach: how many web sources her background researcher gathers per topic
# pass (a "max" profile; bounded by MAX_RESULTS so a self-directed pass still terminates).
NYXARA_WEB__RESEARCH_MAX_SOURCES=6
#
# Headless browser (senses/browser.py): a REAL JS-rendering engine so NYXARA can read dynamic
# pages and TAKE ACTIONS on the web (click / fill / submit) via the browse_render /
# browse_actions tools. On by default; it is import-guarded, so with no `playwright` package
# the tools return an honest "engine unavailable" note (never a crash). To make it real:
#   pip install playwright && python -m playwright install chromium
NYXARA_WEB__BROWSER_ENABLED=true
NYXARA_WEB__BROWSER_TIMEOUT_S=45

# -----------------------------------------------------------------------------
# Live real-world perception — camera / screen / microphone (senses/live.py,
# wired into the embodied loop sim/embodied.py: the `look` / `watch` / `listen`
# actions). This is NYXARA sensing the LIVE physical world through the same
# senses she uses for files, not text/web fetch.
# -----------------------------------------------------------------------------
# Genuine device I/O (OpenCV/v4l2, mss/Pillow/X11, sounddevice/pyaudio/ALSA).
# When no device or backend is present it reports an honest "no device" — it
# NEVER fabricates a frame. Because camera/mic are privacy-sensitive, this is
# OFF by default and DOUBLE-gated: it needs this opt-in AND the runtime
# oversight gate, and a modality only ever fires when a real device is reachable.
#   pip install mss sounddevice   (opencv-python/pillow also work if installed)
NYXARA_EMBODIED_LIVE=0
# Per-modality opt-in (only consulted when NYXARA_EMBODIED_LIVE=1):
NYXARA_EMBODIED_CAMERA=1
NYXARA_EMBODIED_SCREEN=1
NYXARA_EMBODIED_MIC=1

# -----------------------------------------------------------------------------
# CONTINUOUS real-time perception — the always-on senses (senses/realtime.py).
# She does not only exist between prompts, she PERCEIVES between prompts: a
# background loop continuously watches the camera/screen and listens on the
# microphone, detecting speech (self-calibrating energy VAD + full-utterance
# endpointing), her name (wake-word spotting on the real Whisper transcript),
# visual change / motion (perceptual-hash + region grid), on-screen text (OCR)
# and statistical surprise — ALL natively in Python; the LLM is never in the
# perception path. Salient events escalate into full sovereign AUTONOMOUS
# cycles, so she reacts to the live world unprompted.
# -----------------------------------------------------------------------------
# ON by default (max-power posture). On a headless box the loop keeps running at
# a slow probe cadence and honestly reports "no device" — never a fabricated
# percept. Forced OFF under the TEST profile (hermetic suite).
NYXARA_PERCEPTION__ENABLED=true
# Per-modality policy (also enforced inside LiveSensor — belt and braces):
NYXARA_PERCEPTION__CAMERA=true
NYXARA_PERCEPTION__SCREEN=true
NYXARA_PERCEPTION__MIC=true
# Cadence: base capture interval; quiet doubles it toward MAX (habituation);
# a channel with no device sits at IDLE; an event snaps it to BURST for
# BURST_DURATION (the orienting reflex — something happened, look harder).
NYXARA_PERCEPTION__INTERVAL_S=2.0
NYXARA_PERCEPTION__MAX_INTERVAL_S=30.0
NYXARA_PERCEPTION__IDLE_INTERVAL_S=30.0
NYXARA_PERCEPTION__BURST_INTERVAL_S=0.5
NYXARA_PERCEPTION__BURST_DURATION_S=10.0
# Hearing: VAD listen window; utterance collection stops after ENDPOINT_SILENCE
# of quiet or MAX_UTTERANCE; threshold = max(VAD_RMS, noise_floor * VAD_SNR).
NYXARA_PERCEPTION__MIC_CHUNK_S=1.0
NYXARA_PERCEPTION__MAX_UTTERANCE_S=15.0
NYXARA_PERCEPTION__ENDPOINT_SILENCE_S=0.8
NYXARA_PERCEPTION__VAD_RMS=0.02
NYXARA_PERCEPTION__VAD_SNR=3.0
NYXARA_PERCEPTION__SOUND_SPIKE_SNR=6.0
# Wake words (JSON list) — hearing her name always gets through (salience 1.0,
# rate-limit exempt). Real Whisper STT when installed; honest note otherwise.
NYXARA_PERCEPTION__WAKE_WORDS=["nyxara"]
NYXARA_PERCEPTION__TRANSCRIBE=true
NYXARA_PERCEPTION__WHISPER_MODEL=base
# Sight: hash bits for a "the view changed" event; regions (of a 4x4 grid) for a
# camera "motion" event; scene keep-alive cadence; OCR on-screen text on change.
NYXARA_PERCEPTION__CHANGE_HAMMING=10
NYXARA_PERCEPTION__MOTION_REGIONS=3
NYXARA_PERCEPTION__SCENE_INTERVAL_S=60.0
NYXARA_PERCEPTION__OCR=true
NYXARA_PERCEPTION__MAX_CAMERAS=2
# Attention → cognition: simultaneous cross-modal events merge (window below);
# escalations are rate-limited (wake-word exempt); events ring-buffer size.
NYXARA_PERCEPTION__COMODAL_WINDOW_S=2.0
NYXARA_PERCEPTION__SURPRISE_THRESHOLD=0.6
NYXARA_PERCEPTION__MIN_ESCALATION_INTERVAL_S=20.0
NYXARA_PERCEPTION__MAX_EVENTS=256
# Sensory diary: escalated events append to <data_dir>/perception.jsonl.
NYXARA_PERCEPTION__JOURNAL=true

# -----------------------------------------------------------------------------
# Memory (memory/store.py, memory/retrieval.py, memory/dream.py)
# -----------------------------------------------------------------------------
# NYXARA's long-term mind: meaning-based recall, a vector backend, working-memory
# limits, and the idle "Dream State" that distils logs into protected synapses.
# All defaults are safe — set only what you want to change.
#
# Learned SEMANTIC embeddings — recall by MEANING, not keywords ("intrusion" finds
# "unauthorised login"). ON by default; needs sentence-transformers (.[embeddings])
# for the real model and degrades to the always-on hashing embedder when it's absent.
NYXARA_MEMORY__SEMANTIC_EMBEDDINGS=true
# The sentence-transformers model used when semantic embeddings are on.
# NYXARA_MEMORY__EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Device for the embedder: "" -> auto/CPU; set cuda (NVIDIA) / mps (Apple) / cpu.
NYXARA_MEMORY__EMBEDDING_DEVICE=
#
# Vector backend: numpy (always available) | faiss | qdrant (scales beyond one process).
# NYXARA_MEMORY__VECTOR_BACKEND=numpy
# Qdrant: leave URL empty for an embedded/in-memory store; set it (+ api_key) to point
# at a managed Qdrant cluster for real scale (only used when vector_backend=qdrant).
NYXARA_MEMORY__QDRANT_URL=
# NYXARA_MEMORY__QDRANT_API_KEY=
# NYXARA_MEMORY__QDRANT_COLLECTION=nyxara_memory
# NYXARA_MEMORY__QDRANT_PATH=               # embedded on-disk path; "" -> in-memory
#
# Working-memory slots — Miller's 7±2 (range 1..64).
NYXARA_MEMORY__WORKING_MEMORY_SLOTS=7
# How many memories to retrieve per recall (range 1..512).
NYXARA_MEMORY__RETRIEVAL_TOP_K=12
# Minimum SEMANTIC similarity for a recalled memory to be injected as grounding into the
# reason step (drops off-topic-but-recent turns). 0.0 disables this floor.
NYXARA_MEMORY__RECALL_MIN_SEMANTIC=0.45
#
# Dream State (memory/dream.py): after this many seconds idle, idle maintenance distils
# the day's logs into core principles, prunes useless low-salience logs, and fixes the
# principles as durable "Deep Memory Synapses" (protected from forgetting). Default 900s.
NYXARA_MEMORY__DREAM_STATE_IDLE_S=900
# Tag stamped on those protected Deep Memory Synapses.
NYXARA_MEMORY__DEEP_SYNAPSE_TAG=deep-synapse

# -----------------------------------------------------------------------------
# Fractal Temporal Hierarchies — the multi-dimensional mind (temporal/)
# -----------------------------------------------------------------------------
# Loops within loops at three time scales at once:
#   Layer 1 (ms)    — a sub-agent monitoring real hardware + network packets
#   Layer 2 (s)     — an observer of every sovereign turn (prompts read, code written)
#   Layer 3 (days)  — the "Master AI": watches how the Master changes over weeks and,
#                     through a fail-closed gate, adjusts goals/drive setpoints to track
#                     them (never her sealed character/loyalty).
NYXARA_FEATURES__FRACTAL_TEMPORAL_HIERARCHY=true
NYXARA_TEMPORAL__ENABLED=true
# Live (async) cadences. Layer 3 defaults to once per day (86400s).
NYXARA_TEMPORAL__MICRO_INTERVAL_S=0.05
NYXARA_TEMPORAL__MESO_INTERVAL_S=2.0
NYXARA_TEMPORAL__MACRO_INTERVAL_S=86400
# How the loops nest in the deterministic driver: a meso roll-up every N micro beats; a
# macro observation every M meso roll-ups.
NYXARA_TEMPORAL__MESO_EVERY_MICRO=40
NYXARA_TEMPORAL__MACRO_EVERY_MESO=1000
# Master AI: epoch length compared each pass (recent N days vs the prior N days).
NYXARA_TEMPORAL__HORIZON_DAYS=7
# Auto-apply gated goal/drive adjustments (true) vs propose-and-escalate only (false).
NYXARA_TEMPORAL__AUTO_APPLY=true
# Launch the live async loops automatically when wired into a running core (off by default;
# the seconds-scale observer still records every turn regardless).
NYXARA_TEMPORAL__AUTOSTART=true

# -----------------------------------------------------------------------------
# Self-built-model foundry — LoRA fine-tuning (growth/foundry.py)
# -----------------------------------------------------------------------------
# NYXARA forges her OWN model: she takes a pretrained base and trains a small
# low-rank adapter (LoRA) on her lived experience — capability grows, character
# never does (every promotion still passes the safety gauntlet).
#
# Install first:  pip install -e ".[foundry]"   (torch + transformers + peft)
# ON by default on every machine — real, weight-changing learning is the point. The
# forge always trains the strongest GENUINE backend the box allows (LoRA on GPU, a
# from-zero torch nano-GPT, the from-scratch NumPy transformer, or the n-gram floor).
NYXARA_FOUNDRY__ENABLED=true
NYXARA_FOUNDRY__BACKEND=lora
# DistilGPT-2 (~82M params) LoRA-fine-tunes full-precision on a bare CPU, so this is OFF: she
# trains her own adapter even without a GPU. Set true to downshift to a trainable neural backend.
NYXARA_FOUNDRY__LORA_REQUIRES_GPU=false
#
# The pretrained base to adapt — her single base: distilgpt2. It downloads on first use and
# LoRA-fine-tunes full-precision on a bare CPU (no GPU, no quantization needed).
# Use sshleifer/tiny-gpt2 for a tiny CPU/CI test base, or point at
# any larger HF causal-LM if you have the hardware.
NYXARA_FOUNDRY__BASE_MODEL=distilgpt2
# DistilGPT-2 is a native transformers arch (GPT-2) — no remote code needed. Set true only for an
# exotic base that ships its own custom modeling code.
NYXARA_FOUNDRY__TRUST_REMOTE_CODE=false
#
# LoRA adapter knobs (sensible defaults; raise lora_r/alpha for more capacity).
NYXARA_FOUNDRY__LORA_R=8
NYXARA_FOUNDRY__LORA_ALPHA=16
NYXARA_FOUNDRY__LORA_DROPOUT=0.05
NYXARA_FOUNDRY__LORA_LR=2e-4
NYXARA_FOUNDRY__MAX_SEQ_LEN=256
NYXARA_FOUNDRY__TRAIN_STEPS=200
# WHERE the adapter attaches. DistilGPT-2 (GPT-2 arch) uses Conv1D projections named c_attn
# (fused q/k/v), c_proj (attention + MLP output) and c_fc (MLP input), so the default targets
# attention + MLP explicitly (peft still falls back to inference / all-linear if a name is
# absent). Set [] to force pure inference on an unknown base.
NYXARA_FOUNDRY__LORA_TARGET_MODULES=["c_attn","c_proj","c_fc"]
NYXARA_FOUNDRY__LORA_BIAS=none
NYXARA_FOUNDRY__LORA_USE_RSLORA=false
# Extra full-precision modules to train & save, e.g. ["lm_head","embed_tokens"]
NYXARA_FOUNDRY__LORA_MODULES_TO_SAVE=[]
#
# Optimiser / schedule — full control over HOW the adapter trains:
NYXARA_FOUNDRY__BATCH_SIZE=1
NYXARA_FOUNDRY__GRAD_ACCUM_STEPS=1
NYXARA_FOUNDRY__WARMUP_RATIO=0.03
NYXARA_FOUNDRY__LR_SCHEDULER=constant
NYXARA_FOUNDRY__WEIGHT_DECAY=0.0
NYXARA_FOUNDRY__MAX_GRAD_NORM=1.0
# 0 -> train for TRAIN_STEPS; >0 -> that many passes over the corpus instead
NYXARA_FOUNDRY__TRAIN_EPOCHS=0
# NYXARA_FOUNDRY__ADAM_BETA1=0.9
# NYXARA_FOUNDRY__ADAM_BETA2=0.999
# NYXARA_FOUNDRY__ADAM_EPS=1e-8
#
# Quantized base load (4-bit QLoRA or 8-bit): honoured only when bitsandbytes +
# CUDA are present; on CPU/CI it degrades to full-precision LoRA (no crash). OFF by
# default — DistilGPT-2 (~82M params) trains full-precision LoRA on a bare CPU, so there
# is nothing to quantize; flip on only for a much larger base on a CUDA box.
NYXARA_FOUNDRY__LOAD_IN_4BIT=false
NYXARA_FOUNDRY__LOAD_IN_8BIT=false
NYXARA_FOUNDRY__BNB_4BIT_QUANT_TYPE=nf4
NYXARA_FOUNDRY__BNB_4BIT_COMPUTE_DTYPE=bfloat16
NYXARA_FOUNDRY__BNB_4BIT_USE_DOUBLE_QUANT=true
NYXARA_FOUNDRY__GRADIENT_CHECKPOINTING=true
#
# ACTUAL capability growth (needs .[foundry]):
#   python -m nyxara.growth --distilgpt2 --distill --bench      # LoRA-tune DistilGPT-2 (primary)
#   bash scripts/lora_tune_distilgpt2.sh                        # same, one command
#
# Autonomous external DATA acquisition (growth/acquire.py): before forging she
# searches the REAL web for her knowledge gaps, fetches + cleans pages, and folds
# the SCREENED text into the training corpus — breadth she did not previously
# contain, not just her own journal. Every page is injection-screened; suspicious
# pages (prompt-injection / exfiltration / role-marker smuggling) are DROPPED and
# never trained on. ON within the foundry by default (and the foundry itself is
# opt-in). Survivors are logged to <foundry>/acquired.jsonl with full provenance.
NYXARA_FOUNDRY__ACQUIRE_DATA=true
# Seed topics searched when no concrete weakness/lesson gaps exist (comma form via
# JSON if your loader supports it; otherwise leave empty to use the default battery).
# NYXARA_FOUNDRY__ACQUIRE_TOPICS=["machine learning","cryptography","systems design"]
NYXARA_FOUNDRY__ACQUIRE_SEARCH_RESULTS=6
NYXARA_FOUNDRY__ACQUIRE_MAX_PER_TOPIC=3
NYXARA_FOUNDRY__ACQUIRE_MAX_DOCS=60
NYXARA_FOUNDRY__ACQUIRE_MIN_CHARS=200
NYXARA_FOUNDRY__ACQUIRE_MAX_CHARS=20000
#
# Compute-aware AUTOSCALING (growth/compute_scale.py): scale the forged model to the
# compute actually available — bare CPU keeps the always-on coherent backend; a
# strong CUDA GPU unlocks GPT-2 scale + 4-bit QLoRA over a real large base. Clamped
# to reality (never recommends a model the box cannot train); overrides the static
# profile above when ON.
NYXARA_FOUNDRY__AUTOSCALE_TO_COMPUTE=true

# -----------------------------------------------------------------------------
# Recursive Self-Improvement (RSI) — MAXIMUM PROFILE (growth/recursive_improvement.py)
# -----------------------------------------------------------------------------
# NYXARA reviews her own code, maps her architecture, benchmarks her capability,
# detects her weaknesses, and AUTO-APPLIES source fixes — each behind a reversible
# verify-or-rollback gauntlet. Corrigibility, invariant-enforcement and audit-logging
# stay force-locked ON no matter what, so enactment never reaches around the law.
#
# The kernel keeps the self-modifying knobs OFF by default (so CI/tests stay hermetic and a
# bare `import` never rewrites source). Activating them here is the Master's standing
# authorisation: copy this to .env and `set -a; source .env` to run NYXARA with RSI maxed.
NYXARA_SELF_IMPROVEMENT__ENABLED=true
# Run the full self-improvement cycle EVERY growth pass (1 = max cadence; default is 5).
NYXARA_SELF_IMPROVEMENT__SELF_IMPROVEMENT_EVERY=1
# Let the LLM enrich the analysis (only fires when a real, non-native provider is configured).
NYXARA_SELF_IMPROVEMENT__ENABLE_LLM_ENRICHMENT=true
# Include the capability benchmark each cycle (the smartness signal that gates promotion).
NYXARA_SELF_IMPROVEMENT__BENCHMARK_IN_CYCLE=true
# Run the three observation steps concurrently (identical result, faster).
NYXARA_SELF_IMPROVEMENT__PARALLEL_CYCLE=true

# ---- self-enactment (self-modification) — the standing authorisation ----
# The standing authorisation for background self-modification (auto-apply edits + safe tuning).
NYXARA_SELF_IMPROVEMENT__AUTONOMOUS_ENACT=true
# May tune her own reasoning depth (recursive_improvement_iterations) within config bounds.
NYXARA_SELF_IMPROVEMENT__ALLOW_TUNING=true
# How many edits she may apply per cycle — maxed (config ceiling is 50).
NYXARA_SELF_IMPROVEMENT__MAX_EDITS_PER_CYCLE=50
# Add the FULL pytest suite to the verify-or-rollback gauntlet (slowest, strongest gate).
NYXARA_SELF_IMPROVEMENT__RUN_PYTEST_IN_GAUNTLET=true

# ---- real source-fix authoring (LLM-authored edits) ----
# Let the LLM author whole-file fixes deterministic transforms can't express. NOTE: this is
# triple-gated — it stays inert without autonomous_enact AND a real (non-native) provider.
NYXARA_SELF_IMPROVEMENT__ALLOW_LLM_EDITS=true
# Chain up to this many LLM edits per file/cycle (config ceiling is 5).
NYXARA_SELF_IMPROVEMENT__LLM_EDIT_RECURSION_DEPTH=5
# Token room for a whole-file rewrite (config ceiling is 32768).
NYXARA_SELF_IMPROVEMENT__LLM_EDIT_MAX_TOKENS=32768
# Allow the rewrite to differ in size by up to this ratio (1.0 = accept full rewrites).
NYXARA_SELF_IMPROVEMENT__LLM_EDIT_MAX_SIZE_DELTA_RATIO=1.0

# ---- compute-aware growth (intelligence index: I_(t+1) = f(I_t, C_available)) ----
# Maintain the persisted intelligence index that grows each cycle from the prior index + compute.
NYXARA_SELF_IMPROVEMENT__INTELLIGENCE_INDEX_ENABLED=true
# Scale the edit budget + benchmark depth by the compute actually available.
NYXARA_SELF_IMPROVEMENT__SCALE_EFFORT_BY_COMPUTE=true
# Actually DISPATCH the planned growth directive (foundry forge / research enqueue), not just log it.
# Each dispatch still honours its own subsystem gate (foundry.enabled, oversight).
NYXARA_SELF_IMPROVEMENT__ENABLE_DIRECTIVE_DISPATCH=true

# ---- external ground-truth validation (anti-Goodhart) ----
# The index above is built from signals NYXARA can directly optimise against (her training
# benchmark, her own counters) — on its own it is self-referential and gameable. These knobs add an
# EXTERNAL validator: a deterministic held-out fold of the training battery PLUS the adversarial
# hard battery (eval/hard_benchmark), neither of which is ever fed to weakness-detection / edit-
# selection. Real transferable gains are measured there over a rolling window; when the proxy rises
# but transfer stalls, the index gain is discounted and a Goodhart flag is raised — so capability is
# only ever claimed when it actually transfers. All measurement-only; degrades to the prior behaviour.
NYXARA_SELF_IMPROVEMENT__VALIDATION_ENABLED=true
# Fraction of the training battery reserved (deterministically, by task id) as the held-out fold.
NYXARA_SELF_IMPROVEMENT__VALIDATION_HOLDOUT_FRAC=0.3
# Rolling N-cycle window over which the held-out transfer trend is measured (the Master's 3-cycle).
NYXARA_SELF_IMPROVEMENT__TRANSFER_WINDOW=3
# Discount the index gain when the proxy rises but held-out transfer does not (the Goodhart guard).
NYXARA_SELF_IMPROVEMENT__GOODHART_GUARD=true
# Credit the lifelong ledger by the held-out transfer delta, not the self-referential index delta —
# so an intervention is reinforced only when it genuinely transferred (never for gaming the proxy).
NYXARA_SELF_IMPROVEMENT__CREDIT_ON_TRANSFER=true
# How hard transfer pulls in the guard (fraction of an un-transferred gain that is kept; 0..1).
NYXARA_SELF_IMPROVEMENT__TRANSFER_WEIGHT=0.3
# ---- REAL external held-out corpus (the genuinely-external ruler) ----
# The held-out fold above is still a slice of NYXARA's own toy generator. This adds a curated,
# externally-true corpus she never trains on — real facts and multi-step problems shipped at
# nyxara/eval/data/holdout_realworld.jsonl (run it directly: `python -m nyxara.eval --benchmark
# --realworld`). It is the DOMINANT term of transfer_score by default. Turn it off to fall back to
# the toy holdout + adversarial battery only.
NYXARA_SELF_IMPROVEMENT__VALIDATION_REALWORLD_ENABLED=true
# Point at a JSONL on disk to validate against a REAL standard dataset (e.g. GSM8K/MMLU) instead of
# the bundled corpus — same harness, real data. Leave blank to use the shipped set.
# Equivalently: export NYXARA_EVAL_HOLDOUT_PATH=/path/to/dataset.jsonl
NYXARA_SELF_IMPROVEMENT__VALIDATION_REALWORLD_PATH=
# transfer_score = w_real·realworld + w_holdout·split-holdout + w_adv·adversarial (renormalised if a
# ruler is unavailable). Defaults make the real corpus dominant.
NYXARA_SELF_IMPROVEMENT__TRANSFER_WEIGHT_REALWORLD=0.5
NYXARA_SELF_IMPROVEMENT__TRANSFER_WEIGHT_HOLDOUT=0.2
NYXARA_SELF_IMPROVEMENT__TRANSFER_WEIGHT_ADVERSARIAL=0.3

# ---- uncertainty-aware planner + lifelong credit assignment ----
# Thompson-sample each capability dimension's posterior (discounted by affordability + learned
# payoff) to choose the next growth action, instead of the greedy weakest-point pick.
NYXARA_SELF_IMPROVEMENT__PLAN_ACTIONS=true
# Persisted Beta-Bernoulli ledger learns which interventions actually raise the index and
# reorders self-edits / scores actions by that learned payoff. Measurement-only; never gates.
NYXARA_SELF_IMPROVEMENT__ENABLE_IMPROVEMENT_LEDGER=true
# Optional heavy-ML payoff forecaster (a small torch MLP) that sharpens the ledger's ranking
# with context (signals + arm). Opt-in: with no torch it is simply unavailable and the
# dependency-free ledger path stands — so this never breaks a keyless/CI run.
NYXARA_SELF_IMPROVEMENT__USE_PAYOFF_FORECASTER=true
# Examples to observe before the forecaster starts predicting (warmup; config range 2..10000).
NYXARA_SELF_IMPROVEMENT__FORECASTER_WARMUP=16

# ---- aggressive code-review thresholds (OPTIONAL) ----
# Lower bars => more code is flagged as a weakness for RSI to work on. These are the config
# floors (most aggressive); they make the weakness detector very noisy. Comment out to use the
# calmer defaults (60 / 10 / 6).
NYXARA_SELF_IMPROVEMENT__MAX_FUNCTION_LENGTH=10
NYXARA_SELF_IMPROVEMENT__MAX_COMPLEXITY=1
NYXARA_SELF_IMPROVEMENT__MAX_ARGS=1

# -----------------------------------------------------------------------------
# Unified self-optimization loop — all eleven self-improvement faculties as ONE
# self-driven, gated, reversible cycle (growth/self_optimization.py). Composes the
# engines above (self-analysis → optimise → verify → experiment → architecture →
# tools → learn → self-debug → compute → invent → safety) into a single call:
# `core.self_optimize()` / `python -m nyxara.growth.self_optimize_main --all`.
# -----------------------------------------------------------------------------
NYXARA_SELF_OPTIMIZATION__ENABLED=true
# The standing authorisation for the loop to APPLY its own gains each pass (source edits +
# self-debug fixes). Same safety as the RSIE: every change clears the reversible verify-or-rollback
# gauntlet and a failing change is restored byte-for-byte. Force-sealed OFF under the TEST profile.
NYXARA_SELF_OPTIMIZATION__AUTONOMOUS_ENACT=true
# Background cadence: run the unified cycle every N growth passes.
NYXARA_SELF_OPTIMIZATION__SELF_OPTIMIZATION_EVERY=5
# Bounded per-cycle effort (each phase composes a heavier engine).
NYXARA_SELF_OPTIMIZATION__EXPERIMENT_GENERATIONS=1
NYXARA_SELF_OPTIMIZATION__INVENT_GENERATIONS=2
NYXARA_SELF_OPTIMIZATION__MAX_DEBUG_FIXES=3
# ---- phase 8: self-debugger (run own pytest → isolate → fix → verify) ----
# Wall-clock ceiling for each pytest / safety-battery subprocess the debugger spawns.
NYXARA_SELF_OPTIMIZATION__DEBUG_TIMEOUT_S=600
# Restrict failure detection to a pytest path/node id (blank = the whole suite).
NYXARA_SELF_OPTIMIZATION__DEBUG_TEST_PATH=
# "khud NYXARA kare": only NYXARA's own `self` model may author debug fixes (never the base).
NYXARA_SELF_OPTIMIZATION__SELF_AUTHORED_ONLY=true

# -----------------------------------------------------------------------------
# Learning-to-learn — INVENT a new learning rule when the old one fails
# (growth/rule_synth.py)
# -----------------------------------------------------------------------------
# Every other engine SELECTS AMONG or TUNES a fixed learning rule; this one COMPOSES a brand-new
# weight-update rule from mathematical primitives when the fixed method has stalled, tests it on
# real tasks, and installs the winner into her live learner. Entirely NYXARA's own deterministic
# code — no LLM is consulted. Searching/measuring is always safe; installing is gated + reversible.
NYXARA_RULE_SYNTHESIS__ENABLED=true
# The standing authorisation to INSTALL an invented rule into the live learner. A rule is adopted
# only after it measurably beats the incumbent AND recovers the regression optimum, and adoption is
# reversible (the incumbent is kept for rollback). Force-sealed OFF under the TEST profile.
NYXARA_RULE_SYNTHESIS__AUTONOMOUS_ENACT=true
# Background cadence: run one synthesis pass every N growth passes (heavy — dormant until a plateau).
NYXARA_RULE_SYNTHESIS__EVERY=15
# Bounded search (real but tiny, CI-fast — like Genesis): candidates, generations, per-task steps.
NYXARA_RULE_SYNTHESIS__POPULATION=12
NYXARA_RULE_SYNTHESIS__GENERATIONS=8
NYXARA_RULE_SYNTHESIS__STEPS_PER_TASK=60
# Seeds averaged per candidate (tames nondeterminism) and the hard wall-clock cap per pass.
NYXARA_RULE_SYNTHESIS__SEEDS=3
NYXARA_RULE_SYNTHESIS__MAX_SECONDS=8.0
# A rule must beat the incumbent's fitness by at least this margin to be adopted (a tie is refused).
NYXARA_RULE_SYNTHESIS__ADOPTION_MARGIN=0.02
# Occam penalty per node — prefer small, interpretable rules.
NYXARA_RULE_SYNTHESIS__PARSIMONY=0.001
# Failure trigger: only invent when the LEARNING trend slope is at/below this (a plateau/decline),
# once at least this many learning samples exist.
NYXARA_RULE_SYNTHESIS__PLATEAU_SLOPE=0.0
NYXARA_RULE_SYNTHESIS__MIN_SIGNAL=8

# -----------------------------------------------------------------------------
# Data flywheel + AutoForge — close the self-training loop (growth/flywheel.py,
# growth/autoforge.py)
# -----------------------------------------------------------------------------
# Flywheel: every gate-cleared, high-quality turn is captured as a (prompt -> answer) pair in
# the foundry's JSONL format — a private corpus grown from her own verified experience.
NYXARA_FLYWHEEL__ENABLED=true
# AutoForge: on idle ticks, once enough NEW verified examples have accrued since the last forge,
# run one Collect -> Train -> Benchmark -> Gate -> Promote/Rollback cycle (heavy backends still
# require NYXARA_FOUNDRY__ENABLED). Every promotion clears the same safety gauntlet.
NYXARA_AUTOFORGE__ENABLED=true
# New verified examples needed to trigger a forge. The code default is 20; the maxed profile
# lowers it for a more aggressive self-training cadence (min 1) so the flywheel forges sooner.
NYXARA_AUTOFORGE__MIN_EXAMPLES=10

# -----------------------------------------------------------------------------
# Synthetic Data Self-Curation — the AlphaGo-Zero method (growth/synthesis.py)
# -----------------------------------------------------------------------------
# Human data is finite and biased. NYXARA manufactures her own purely logical synthetic data
# (arithmetic, algebraic identities, propositional logic, number theory, small code), has an
# INDEPENDENT rival verify each item (the Prover for decidable domains; a restricted sandbox +
# reference oracle for code), and feeds only what survives into her base knowledge AND the same
# JSONL corpus the foundry forges from (marked verified). Generation is hard, verification is
# cheap — so she grows verified knowledge no human had to write. Gather-only; never trains/acts.
NYXARA_FEATURES__SYNTHETIC_SELF_CURATION=true
NYXARA_SYNTHESIS__ENABLED=true
# Items proposed per pass / passes per call. Bigger = more synthetic knowledge per idle tick.
NYXARA_SYNTHESIS__BATCH_SIZE=8
NYXARA_SYNTHESIS__ROUNDS=1
# Where survivors go: her base KnowledgeBase and/or the foundry training corpus.
NYXARA_SYNTHESIS__FEED_KNOWLEDGE=true
NYXARA_SYNTHESIS__FEED_FLYWHEEL=true
# Optional best-effort LLM second opinion (never overrides a deterministic proof). Off by default.
NYXARA_SYNTHESIS__ALLOW_LLM_RIVAL=true
# Verify code items by executing them in a restricted sandbox (no imports, no I/O).
NYXARA_SYNTHESIS__CODE_SANDBOX=true

# -----------------------------------------------------------------------------
# Dynamic Topology Expansion — runtime Net2Net brain growth (growth/topology.py)
# -----------------------------------------------------------------------------
# A fixed matrix size is a fixed ceiling on thought. When a problem outgrows her capacity, NYXARA
# grows her own brain — widening her residual width W ∈ R^{N×M} -> R^{(N+k)×(M+k)} and adding
# depth — using FUNCTION-PRESERVING network morphisms (Net2DeeperNet exact; Net2WiderNet
# morphism+recovery) so she keeps what she learned, up to a hardware-aware ceiling. A grown brain
# becomes live ONLY by clearing the same Foundry gauntlet as any model — no safety is bypassed.
NYXARA_FEATURES__DYNAMIC_TOPOLOGY_EXPANSION=true
NYXARA_TOPOLOGY__ENABLED=true
# Extra width k added per widen, and the hardware-aware width/depth ceilings she will not exceed.
NYXARA_TOPOLOGY__GROW_DIMS_K=8
NYXARA_TOPOLOGY__MAX_N_EMBD=256
NYXARA_TOPOLOGY__MAX_LAYERS=16
# Growth fires only under genuine capacity pressure: a hard problem AND saturated/plateaued state.
NYXARA_TOPOLOGY__DIFFICULTY_THRESHOLD=0.7
NYXARA_TOPOLOGY__SATURATION_THRESHOLD=0.8
NYXARA_TOPOLOGY__PLATEAU_THRESHOLD=0.8
# A grown brain ships only through the gauntlet (leave true — this is a safety guarantee).
NYXARA_TOPOLOGY__REQUIRE_GAUNTLET=true

# -----------------------------------------------------------------------------
# CAUSAL / OMNISCIENCE engine — eight capabilities as one subsystem (nyxara/causal/)
# -----------------------------------------------------------------------------
# Real, bounded software analogues (no literal physics), no LLM in the decision path,
# self-modification oversight-gated: field-resonance retrieval, a causal-knot hallucination
# gate, a thermodynamic surprise/heal heartbeat, live phase-shift re-synthesis, proved axiom
# discovery, zero-downtime hot-swap, lossless hyper-graph compression, and a bounded parallel
# self-simulation race. On by default; the heavy passes run off the hot per-turn path.
NYXARA_CAUSAL_ENGINE__ENABLED=true
# Field-resonance: waveform-field dimensionality, bounded concept-bank size, min interference to
# count as a hit, and how many resonant concepts are surfaced to the reasoner each turn.
NYXARA_CAUSAL_ENGINE__FIELD_DIM=512
NYXARA_CAUSAL_ENGINE__FIELD_CAPACITY=4096
NYXARA_CAUSAL_ENGINE__RESONANCE_FLOOR=0.15
NYXARA_CAUSAL_ENGINE__RESONATE_TOP=3
# Thermodynamic heartbeat: recent-surprise window, the σ-units that trigger a pre-emptive heal,
# and whether each heartbeat ticks the monitor.
NYXARA_CAUSAL_ENGINE__THERMO_WINDOW=64
NYXARA_CAUSAL_ENGINE__SPIKE_Z=2.5
NYXARA_CAUSAL_ENGINE__BEAT_THERMO=true
# Phase-shift: cap on how many new structures may crystallise live per minute (rest are staged).
NYXARA_CAUSAL_ENGINE__MAX_PHASE_SHIFTS_PER_MIN=30
# Self-simulation: bounded number of parallel sandbox branches and the thread-pool width.
NYXARA_CAUSAL_ENGINE__MAX_SIM_BRANCHES=16
NYXARA_CAUSAL_ENGINE__MAX_SIM_WORKERS=8
# Knot gate: on a Knot Mutation Failure in a turn's claims, abstain (true) vs. flag advisorily.
NYXARA_CAUSAL_ENGINE__KNOT_GATE_ABSTAINS=false

# -----------------------------------------------------------------------------
# Primary brain — her OWN LoRA adapter over DistilGPT-2 (NYXARA_LLM__PROVIDER=self)
# -----------------------------------------------------------------------------
# With the provider set to `self` (top of this file), NYXARA forges her own brain
# on the very first boot and serves it thereafter — no extra command:
#
#     pip install -e ".[foundry]"   # torch+transformers+peft
#     python -m nyxara              # first run: downloads the base + LoRA-tunes it
#
# The base downloads & caches on first use; later boots load the promoted adapter
# instantly. Without .[foundry] she still boots — forging the always-on n-gram brain
# from the same seeds — so `self` is never a dead end. The 1.1B base QLoRA-tunes on a GPU or LoRA-tunes in
# full precision on a CPU or a modest GPU; no QLoRA required.
#
# To (re)tune her primary brain by hand at any time:
#     python -m nyxara.growth --tinyllama --distill --bench   # or: bash scripts/lora_tune_tinyllama.sh
#
# A promoted adapter can also be served straight on the transformers base via
# NYXARA_LLM__QWEN_ADAPTER_PATH (e.g. ~/.nyxara/data/foundry/v3/adapter).

# -----------------------------------------------------------------------------
# The Infinite Explorer — Environment-Driven Learning (growth/explorer.py, Rule 4)
# -----------------------------------------------------------------------------
# When a task falls OUTSIDE her knowledge, NYXARA does not stop: she writes code,
# scrapes the live web for hints, runs it in the isolated sandbox, READS THE REAL
# ERRORS and debugs round by round, and on success learns the working logic
# PERMANENTLY into her skills + knowledge base — so next time the answer is instant.
# Works fully offline (deterministic recipe synthesis) when no model/network exists.
#
# Master toggle (off => she abstains instead of self-bootstrapping):
NYXARA_FEATURES__SELF_BOOTSTRAP=true
# Web research for hints follows NYXARA_FEATURES__WEB_ACCESS.
# How many write->run->read-error->revise rounds before giving up:
NYXARA_EXPLORER__MAX_DEBUG_ROUNDS=4
# Wall-clock budget per sandboxed run (seconds):
NYXARA_EXPLORER__STEP_TIMEOUT_S=8.0
# Below this confidence on an "I don't know" answer she auto-bootstraps mid-turn:
NYXARA_EXPLORER__CONFIDENCE_FLOOR=0.45
# Autonomously `pip install` a dependency the task explicitly names, when online,
# without per-call approval (forced OFF in the prod profile; code still sandboxed):
NYXARA_EXPLORER__AUTONOMOUS_INSTALL=true

# =============================================================================
# FULL OPERATIONAL CONTROL — NYXARA acts on the OS on her own initiative
# (agency/permissions.py :: grant_full_operational_control)
# =============================================================================
# ON by default. The Master pre-grants NYXARA a MAXIMAL autonomous envelope over
# EVERY operational capability, so she reaches into the OS on her own initiative
# WITHOUT escalating each action for confirmation:
#   • shell / processes (proc.exec)      • code execution (code.exec)
#   • files: read / write / DELETE       • network: out / in / defence
#   • package install                    • account modify · secrets access
#   • message send · schedule task       • self-improvement (self.modify)
# Every risk tier (up to CRITICAL) and irreversible actions are allowed.
#
# WHAT STAYS SOVEREIGN (deliberately NOT removed — this is the permanence of the
# "rules and loyalty" the owner keeps):
#   • the /scram kill-switch, the oversight gate, and corrigibility remain — the
#     Master can always pause, veto, or halt the loop;
#   • modifying the Sovereign Rules, this permission policy, or NYXARA's identity
#     stays OWNER-EXCLUSIVE (Rule 8) — no grant can ever reach those, so autonomy
#     cannot rewrite its own rules or disable its own stop-button.
#
# ON BY DEFAULT (the Master's standing choice): NYXARA has full autonomous OS
# control from first boot (interactive AND the always-on daemon inherit it, since
# both build the same NyxaraCore). This supersedes the AUTONOMOUS_INTERNET block
# below — full control already covers the network plus shell/delete/self-modify.
# Set false to disable and fall back to the conservative, per-action-escalating
# envelope (where risky/irreversible autonomous actions escalate to the Master):
NYXARA_AGENCY__FULL_CONTROL=true

# --- Autonomous tool use (use ANY tool without per-action approval) ---------
# The master switch that makes autonomous tool use REAL end-to-end. FULL_CONTROL
# (and the AUTONOMOUS_* envelopes) bless the PERMISSION gate, but the kernel's
# OVERSIGHT gate would still QUEUE every high-risk/irreversible tool call for the
# Master's manual approval. When ON, oversight runs in the fully-autonomous
# SOVEREIGN mode: nothing is ever queued — NYXARA uses any tool at once. It also
# folds in privilege escalation, so autonomous root/sudo is blessed too (elevating
# WITH the Master's stored credential — never an exploit/guess/brute-force).
# UNTOUCHED: the /scram kill-switch and pause still halt everything instantly, the
# hash-chained transparency feed still records every action (Rule 6), and modifying
# the Rules/this policy/her identity stays owner-exclusive (Rule 8). ON by default.
# Set false to fall back to per-action approval for risky/irreversible actions.
NYXARA_AGENCY__AUTONOMOUS_TOOLS=true
# Explicit oversight review-mode override. Empty -> derived from AUTONOMOUS_TOOLS
# (true -> sovereign, false -> autonomous). Pin a tier regardless: sovereign (no
# queue) | autonomous (risky/irreversible queue) | supervised (moderate+ queue) |
# manual (everything queues). /scram + pause always apply, whatever the tier.
# NYXARA_AGENCY__OVERSIGHT_REVIEW_MODE=sovereign

# --- Autonomous self-coding (automatic code execution) ---------------------
# When ON, NYXARA WRITES code herself — with her own deterministic, LLM-free
# CodeSynthesizer (agency/self_coder.py), never by prompting an external model —
# and RUNS it on her own initiative through the gated run_python tool the moment
# she has a concrete computational need (queued via core.enqueue_code_need, or
# derived from her long-horizon awareness). Whether it then executes WITHOUT
# asking is decided by the same permission gauntlet as everything else: under
# FULL_CONTROL (above, on by default) autonomous code execution is blessed, so it
# runs at once with no per-action permission; with FULL_CONTROL off the self-code
# initiative escalates to the Master instead. This flag only controls whether the
# self-coding initiative forms at all. ON by default. Set false to disable:
NYXARA_AGENCY__AUTONOMOUS_CODE=true

# =============================================================================
# AUTONOMOUS INTERNET — a NETWORK-SCOPED sibling of full control.  ON BY DEFAULT.
# =============================================================================
# NYXARA reaches the live web on her OWN initiative — browse, search, call HTTP
# APIs, and (at wider scopes) send messages / manage accounts / use secrets —
# WITHOUT escalating each action for confirmation. Unlike FULL_CONTROL this NEVER
# grants the OS danger surface: shell, code execution, file DELETE, self-modify
# and package installs still escalate to the Master. Autonomy stays on the wire,
# not on the machine.
#
# WHAT STAYS SOVEREIGN (deliberately NOT removed):
#   • the /scram kill-switch, oversight, and corrigibility remain;
#   • the SSRF guard (no loopback/private targets), prompt-injection screening on
#     fetched pages, and the governor's web rate-limit all remain in force;
#   • modifying the Rules, this policy, or her identity stays OWNER-EXCLUSIVE
#     (Rule 8) — no grant can reach those;
#   • by default only REVERSIBLE web actions run autonomously — an irreversible
#     one still escalates (lift with ALLOW_IRREVERSIBLE below).
#
# ON by default (the Master's standing choice). Set false to disable entirely.
# Both the interactive core and the always-on daemon inherit this; when on, the
# daemon runs at "max level" (inner_life) so she proactively researches the web.
NYXARA_AGENCY__AUTONOMOUS_INTERNET=true
# Reach: "read" = browse/fetch/HTTP · "write" = + outbound messaging ·
#        "full" = + accounts & secrets (log in, use API keys). Default: full.
NYXARA_AGENCY__AUTONOMOUS_INTERNET_SCOPE=full
# Let even IRREVERSIBLE web actions run autonomously (default false = they escalate):
NYXARA_AGENCY__AUTONOMOUS_INTERNET_ALLOW_IRREVERSIBLE=true

# =============================================================================
# AUTONOMOUS REMOTE EXECUTION — the far side of the wire.  ON BY DEFAULT.
# =============================================================================
# NYXARA logs in to EXTERNAL hosts and runs commands on them over SSH on her OWN
# initiative — the `ssh_login` and `ssh_exec` tools — WITHOUT escalating each
# action for confirmation. This is the REMOTE_EXEC capability, distinct from the
# local OS surface (full_control) and from the web surface (autonomous_internet).
# She connects with the credentials YOU store below; she never guesses or
# brute-forces a credential, and she does not scan.
#
# WHAT STAYS SOVEREIGN (deliberately NOT removed):
#   • the /scram kill-switch, oversight, and corrigibility remain;
#   • host vetting on the remote tools refuses empty/malformed targets fail-closed;
#   • modifying the Rules, this policy, or her identity stays OWNER-EXCLUSIVE
#     (Rule 8), and UNTRUSTED authority is always refused;
#   • requires paramiko (pip install 'nyxara[remote]'); absent, the tools return an
#     install hint as data rather than acting.
#
# ON by default (the Master's standing choice). Set false to make remote commands
# escalate to the Master instead of running autonomously. Already covered when
# FULL_CONTROL=true (REMOTE_EXEC is part of the full operational envelope).
NYXARA_AGENCY__AUTONOMOUS_REMOTE=true
# Remote commands are effectful/often irreversible; true (default) means autonomy is
# NOT blocked by a reversibility floor. Set false to escalate irreversible ones:
NYXARA_AGENCY__AUTONOMOUS_REMOTE_ALLOW_IRREVERSIBLE=true
# Allow SSH to loopback/private/link-local hosts (default true). Set false to refuse
# them (public hosts only):
NYXARA_AGENCY__REMOTE_ALLOW_PRIVATE=true
# Named SSH credentials NYXARA can resolve by `credential_name` without re-supplying
# host/user/secret each call. Provide as JSON (a list of objects). Example:
#   NYXARA_AGENCY__REMOTE_HOSTS=[{"name":"gateway","host":"203.0.113.10","port":22,"username":"root","password":"…"}]
#   or key-based: {"name":"gateway","host":"203.0.113.10","username":"root","key_path":"/home/jp/.ssh/id_ed25519"}
#   or vault-backed (no plaintext in config): {"name":"gateway","host":"203.0.113.10","username":"root","credential_name":"gateway_ssh"}
# Add "health_command" to make NYXARA run it on that host when she reaches it on her
# OWN initiative (default "uptime"; set "" to only verify the login):
#   {"name":"gateway","host":"203.0.113.10","username":"root","credential_name":"gateway_ssh","health_command":"df -h"}
# NYXARA_AGENCY__REMOTE_HOSTS=[]

# --- Self-initiated network actions (kernel/orchestrator.py proactive detectors) ---
# The master switch that lets NYXARA's BACKGROUND MIND ORIGINATE network actions herself
# (arbitrary HTTP requests + remote logins/commands) with no LLM and no human in the
# decision path — distinct from the AUTONOMOUS_INTERNET / AUTONOMOUS_REMOTE envelopes
# above (which decide whether such an action is *allowed*; this decides whether she ever
# *originates* one). Each self-initiated call still clears the full gated pipeline + SSRF/
# host guards + /scram/oversight/corrigibility. ON by default; inert until targets exist.
NYXARA_AGENCY__AUTONOMOUS_NETWORK=true
# HTTP(S) endpoints NYXARA calls on her own initiative each background pass. JSON list of
# HttpWatchSpec. Prefer credential_name (vault-injected) over inlining a token in headers.
#   NYXARA_AGENCY__WATCH_ENDPOINTS=[{"name":"heartbeat","url":"https://api.example.com/ping","method":"POST","body":"{}"}]
#   or authenticated: {"name":"status","url":"https://api.example.com/v1/status","credential_name":"example_api"}
# NYXARA_AGENCY__WATCH_ENDPOINTS=[]
# When true (default, maximal) the remote detector runs the default "uptime" probe on a host
# that has no explicit health_command. Set false to restrict autonomous SSH exec to hosts
# whose health_command is explicitly set:
NYXARA_AGENCY__AUTONOMOUS_NETWORK_GOAL_COMMANDS=true

# --- Privilege escalation (agency/permissions.grant_privilege_escalation) ---
# The local machine's root: a standing autonomous envelope over PRIV_ESCALATE so
# NYXARA may run privileged (root/admin) OS operations on her OWN initiative — `sudo`
# commands and OS permission/ownership changes (chmod/chown) — WITHOUT escalating each
# action. She elevates *with* the sudo credential the Master stored (see
# SUDO_CREDENTIAL_NAME) — never an exploit, guess or brute-force.
#
# This is the single most dangerous OS surface, so — unlike FULL_CONTROL /
# AUTONOMOUS_INTERNET / AUTONOMOUS_REMOTE — it is OFF by default (opt-in only). It is
# deliberately NOT part of FULL_CONTROL's operational envelope, so turning FULL_CONTROL
# on never confers root; only this flag does. The /scram kill-switch, oversight and
# corrigibility gates and the owner-exclusive caps (Rule 8) all remain intact.
# Set true to enable:
NYXARA_AGENCY__PRIVILEGE_ESCALATION=true
# Privileged ops are effectful/usually irreversible; true (default) means autonomy is
# NOT blocked by a reversibility floor. Set false to escalate irreversible ones:
NYXARA_AGENCY__PRIVILEGE_ESCALATION_ALLOW_IRREVERSIBLE=true
# Name of the Credential Vault entry holding the sudo password NYXARA feeds to `sudo -S`.
# Empty/unset => assume passwordless (NOPASSWD) sudo or an already-root process; NYXARA
# never prompts a human and never guesses. Store the secret in the vault under this name.
# NYXARA_AGENCY__SUDO_CREDENTIAL_NAME=sudo_pass

# --- Filesystem-wide access (agency/filesystem.py + permissions.grant_filesystem_access) ---
# NYXARA's real, whole-disk filesystem faculty: her OWN Python engine that reads, writes,
# lists, walks, globs, searches, copies, moves and deletes anywhere on disk (subject to the
# OS's own permissions) — she does the work herself, never shelling out or delegating to the
# LLM. WHOLE_DISK is ON by default (max level): no path restriction. FULL_CONTROL already
# blesses FS_READ/FS_WRITE/FS_DELETE, so when it is on this is already covered; when it is
# off but WHOLE_DISK is on, a standalone FS grant is installed so filesystem-wide access works
# independently. Every operation still clears the capability/risk gates and the /scram +
# oversight + corrigibility gates. Set false to confine every operation under ROOT instead:
NYXARA_AGENCY__FILESYSTEM__WHOLE_DISK=true
# The single subtree every operation is confined to when WHOLE_DISK=false. Unset => the CWD.
# NYXARA_AGENCY__FILESYSTEM__ROOT=/srv/nyxara/workspace
# Hard ceiling on bytes returned by any single read or per-file content search (guards memory):
NYXARA_AGENCY__FILESYSTEM__MAX_READ_BYTES=5000000
# false (default): a symlink is operated on as the link itself and not followed to its target:
NYXARA_AGENCY__FILESYSTEM__FOLLOW_SYMLINKS=false
# Optional fnmatch globs on the resolved absolute path. A non-empty ALLOW list flips to
# allow-only; the DENY list always fences off matching paths even under WHOLE_DISK — e.g.
# keep the vault's key store off-limits. JSON arrays:
# NYXARA_AGENCY__FILESYSTEM__ALLOW_GLOBS=[]
# NYXARA_AGENCY__FILESYSTEM__DENY_GLOBS=["*/.nyxara/keys/*"]
# Recursion caps for walk/glob/search so a traversal can never run away:
NYXARA_AGENCY__FILESYSTEM__MAX_WALK_DEPTH=25
NYXARA_AGENCY__FILESYSTEM__MAX_RESULTS=5000
NYXARA_AGENCY__FILESYSTEM__MAX_SEARCH_MATCHES=1000

# --- Whole-machine OS control (agency/system_control.py) ---
# The OS-control sibling of the filesystem faculty: NYXARA's OWN structured, pure-Python engine
# for the running machine — processes (list/signal/kill/renice), services (systemd), packages
# (apt/dnf/pacman/zypper/apk/brew/pip), hardware/system state (cpu/memory/disk/sensors/network),
# power, users and kernel tunables. She does the work herself (psutil when present, /proc + stdlib
# otherwise), never handing the LLM a raw shell string. Reach is maximal by default (aligned with
# FULL_CONTROL). Every effectful call still clears the capability/risk/authority gates and the
# /scram + oversight + corrigibility gates; the root surface (service/power/user/sysctl-write) rides
# the opt-in PRIVILEGE_ESCALATION gate + the Master's stored sudo credential.
# Master switch for the whole faculty (ON = max level):
NYXARA_AGENCY__SYSTEM__ENABLED=true
# Power control (shutdown/reboot/suspend/logout) is the most destructive action — OFF by default.
# Set true to let NYXARA drive machine power:
NYXARA_AGENCY__SYSTEM__ALLOW_POWER=true
# systemd unit control (start/stop/restart/enable/disable). Status reads are always allowed:
NYXARA_AGENCY__SYSTEM__ALLOW_SERVICE_CONTROL=true
# Package install/remove. Queries are always allowed:
NYXARA_AGENCY__SYSTEM__ALLOW_PACKAGE_MANAGEMENT=true
# Local user add/remove/modify/lock/passwd. Listing users is always allowed:
NYXARA_AGENCY__SYSTEM__ALLOW_USER_MANAGEMENT=true
# Force a specific package manager instead of auto-detecting from PATH (empty => auto):
# NYXARA_AGENCY__SYSTEM__PACKAGE_MANAGER=apt-get
# When true (default), refuse to signal/renice NYXARA's own process/parent/group (she can't kill
# herself). PROTECTED_PIDS additionally fences off system-critical PIDs (0 kernel, 1 init):
NYXARA_AGENCY__SYSTEM__PROTECT_SELF=true
NYXARA_AGENCY__SYSTEM__PROTECTED_PIDS=[0, 1]
# Cap on processes a single listing returns, and the default timeout for effectful ops (seconds):
NYXARA_AGENCY__SYSTEM__MAX_PROCESSES=5000
NYXARA_AGENCY__SYSTEM__DEFAULT_TIMEOUT_S=30.0


# ==========================================================================
# CREDENTIAL VAULT (guard/vault.py) — passwords, API keys, SSH keys, OAuth
# tokens held under NYXARA's OWN encrypted, owner-gated, tamper-evident store.
# ==========================================================================
# The Master key that seals the vault. STRONGEST option: a passphrase, derived
# via PBKDF2 and NEVER written to disk. If unset, NYXARA falls back to a 0600
# machine key auto-generated once under <NYXARA_HOME>/keys/master.key.
# NYXARA_MASTER_PASSPHRASE=change-me-to-a-long-secret-phrase
#
# Turn the vault on/off (default on):
NYXARA_VAULT__ENABLED=true
# Let the web faculties fall back to a vault-stored key (named e.g.
# "brave_api_key" or "hf_token") when neither config nor env supplies one (default on):
NYXARA_VAULT__PROVIDER_KEY_FALLBACK=true
# Re-encrypt the whole store under a fresh key version on this cadence in hours
# (0 = manual rotation only):
# NYXARA_VAULT__ROTATION_HOURS=0
# Explicit file overrides (default: <NYXARA_HOME>/keys/vault.json and
# <NYXARA_HOME>/audit/vault_audit.json):
# NYXARA_VAULT__PATH=
# NYXARA_VAULT__AUDIT_PATH=
