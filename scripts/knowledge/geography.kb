India | is_a=country | located_in=South Asia | capital=New Delhi | currency=the Indian rupee | has_property=the most populous country | has_part=the Himalayas | has_part=the Ganges
China | is_a=country | located_in=East Asia | capital=Beijing | currency=the yuan | has_part=the Yangtze | has_part=the Great Wall
Japan | is_a=island country | located_in=East Asia | capital=Tokyo | currency=the yen | has_part=Mount Fuji
Indonesia | is_a=island country | located_in=Southeast Asia | capital=Jakarta | currency=the rupiah
Pakistan | is_a=country | located_in=South Asia | capital=Islamabad | currency=the Pakistani rupee | has_part=the Indus
Bangladesh | is_a=country | located_in=South Asia | capital=Dhaka | currency=the taka
South Korea | is_a=country | located_in=East Asia | capital=Seoul | currency=the won
Saudi Arabia | is_a=country | located_in=Western Asia | capital=Riyadh | currency=the riyal
Turkey | is_a=country | located_in=Asia and Europe | capital=Ankara | currency=the Turkish lira
Iran | is_a=country | located_in=Western Asia | capital=Tehran | currency=the Iranian rial
Vietnam | is_a=country | located_in=Southeast Asia | capital=Hanoi | currency=the dong
Thailand | is_a=country | located_in=Southeast Asia | capital=Bangkok | currency=the baht
Nepal | is_a=country | located_in=South Asia | capital=Kathmandu | currency=the Nepalese rupee | has_part=Mount Everest
Sri Lanka | is_a=island country | located_in=South Asia | capital=Sri Jayawardenepura Kotte | currency=the Sri Lankan rupee

